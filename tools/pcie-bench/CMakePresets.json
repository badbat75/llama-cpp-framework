{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64: ROCm clang++ (HIP) + nvcc (CUDA)",
      "description": "The same configure build.ps1 runs, for IDEs: Ninja, x64, ROCm's clang++ as the CXX compiler, the HIP compile vars scoped to this process (never machine-wide: see common.ps1), output in build/pcie-bench.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/pcie-bench",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "environment": {
        "HIP_DEVICE_LIB_PATH": "$env{HIP_PATH}/lib/llvm/amdgcn/bitcode",
        "HIP_PLATFORM": "amd",
        "LLVM_PATH": "$env{HIP_PATH}/lib/llvm"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "$env{HIP_PATH}/lib/llvm/bin/clang++.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64" }
  ]
}
