// SettingsPage: the configurator's own preferences (not llama-server's; those
// are the Server tab). All state lives in AppState (state.slint).
//
// No Save/Revert row: each toggle applies the moment it is clicked. The
// CheckBox binds two-way, so the property is already flipped when `toggled`
// fires; the Rust handler persists it and, on a failed write, pushes the real
// state back through that same binding (src/gui/settings_tab.rs).

import { CheckBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";
import { SectionCard, LabeledField, LabelColumn, Tokens } from "components.slint";
import { AppState } from "state.slint";
import { Strings } from "strings.slint";

export component SettingsPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: Strings.t("settings");
            font-size: 22px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: Strings.t("settings-intro");
            color: Palette.foreground.transparentize(Tokens.muted);
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionCard {
            heading: Strings.t("startup");
            LabeledField {
                label_width <=> LabelColumn.settings;
                label: Strings.t("start-at-login");
                hint: Strings.t("start-at-login-hint");
                CheckBox {
                    text: Strings.t("start-at-login-toggle");
                    enabled: AppState.startup_supported;
                    checked <=> AppState.start_at_login;
                    toggled => { AppState.toggle_start_at_login(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.settings;
                label: Strings.t("start-minimized");
                hint: Strings.t("start-minimized-hint");
                CheckBox {
                    text: Strings.t("start-minimized-toggle");
                    // Shapes the login entry's command, so it needs one to shape.
                    enabled: AppState.startup_supported && AppState.start_at_login;
                    checked <=> AppState.start_minimized_to_tray;
                    toggled => { AppState.toggle_start_minimized(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.settings;
                label: Strings.t("start-llama-server");
                hint: Strings.t("start-llama-server-hint");
                CheckBox {
                    text: Strings.t("start-llama-server-toggle");
                    checked <=> AppState.start_server_on_launch;
                    toggled => { AppState.toggle_start_server_on_launch(); }
                }
            }
        }

        SectionCard {
            heading: Strings.t("logging");
            LabeledField {
                label_width <=> LabelColumn.settings;
                label: Strings.t("rotate-the-log");
                hint: Strings.t("rotate-the-log-hint");
                CheckBox {
                    text: Strings.t("rotate-log-toggle");
                    enabled: AppState.log_rotate_applies;
                    checked <=> AppState.log_rotate;
                    toggled => { AppState.toggle_log_rotate(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.settings;
                label: Strings.t("only-above");
                hint: Strings.t("only-above-hint");
                LineEdit {
                    accessible-label: "log-rotate-kb";
                    enabled: AppState.log_rotate && AppState.log_rotate_applies;
                    text <=> AppState.log_rotate_kb;
                    input-type: InputType.number;
                    placeholder-text: "1024";
                    accepted => { AppState.commit_log_rotate_kb(); }
                    changed has-focus => {
                        if (!self.has-focus) {
                            AppState.commit_log_rotate_kb();
                        }
                    }
                }
                Text {
                    text: "KB";
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
            }
            if !AppState.log_rotate_applies: Text {
                text: AppState.log_rotate_note;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(Tokens.muted);
            }
        }
    }
}
