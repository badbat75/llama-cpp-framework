; llama.cpp NSIS Installer Template
; Placeholders replaced by 03-package.ps1:
;   @VERSION@ (framework / configurator version), @LLAMA_BUILD@ (bundled
;   llama.cpp release tag, e.g. v0.2.0; a bNNNN build number only when the
;   checkout was not on a release), @STAGING_DIR@, @OUTPUT_FILE@

!include "MUI2.nsh"
!include "WinMessages.nsh"
!include "LogicLib.nsh"

; ── Installer metadata ──────────────────────────────────────────────
Name "llama.cpp-framework v@VERSION@ (llama @LLAMA_BUILD@)"
OutFile "@OUTPUT_FILE@"
InstallDir "$PROGRAMFILES64\llama.cpp"
InstallDirRegKey HKLM "Software\llama.cpp" "InstallDir"
RequestExecutionLevel admin
; NOT /SOLID: a solid datablock is assembled uncompressed, and with the GPU
; runtimes the payload is ~2.9 GB, past the 2 GB an NSIS datablock can hold
; (makensis dies with "error mmapping datablock"). Per-file compression keeps
; the COMPRESSED total under that limit instead (~1.2 GB), which is also what
; a GitHub release asset allows.
SetCompressor lzma

; Write to the native 64-bit registry view, not Wow6432Node; otherwise
; PowerShell reading HKLM:\Software\llama.cpp can't find our keys. Must be
; called from within a Function (not at top-level), so apply it in onInit.
Function .onInit
    SetRegView 64
FunctionEnd
Function un.onInit
    SetRegView 64
FunctionEnd

; ── MUI pages ───────────────────────────────────────────────────────
!define MUI_ICON "@STAGING_DIR@\llama.ico"
!define MUI_UNICON "@STAGING_DIR@\llama.ico"

; Welcome page doubles as the runtime-requirements notice: the installer
; bundles llama.cpp + configurator + the OpenSSL, ROCm and CUDA runtimes
; (03-package.ps1 copies them out of the dists the build linked against), so
; what is left to the machine is what cannot be bundled: the GPU drivers,
; which also bring the Vulkan loader, and the VC++ runtime. A backend whose
; driver is missing is skipped silently at runtime. Say it HERE, because
; nothing says it later.
!define MUI_WELCOMEPAGE_TITLE "llama.cpp-framework v@VERSION@"
!define MUI_WELCOMEPAGE_TEXT "This installs llama.cpp-framework (llama.cpp @LLAMA_BUILD@) with the llama-cpp-config configurator. The AMD ROCm, NVIDIA CUDA and OpenSSL runtime libraries are bundled.$\r$\n$\r$\nNot bundled - needed at runtime:$\r$\n$\r$\n- Visual C++ Redistributable x64: always required$\r$\n$\r$\n- AMD GPU: the Adrenalin driver$\r$\n$\r$\n- NVIDIA GPU: the NVIDIA driver$\r$\n$\r$\n- Vulkan: nothing to install (ships with GPU drivers)$\r$\n$\r$\nA backend whose driver is missing is skipped when llama-server starts."

!insertmacro MUI_PAGE_WELCOME
Page custom CheckAndStopProcesses
Page custom CheckPreviousInstall
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; ── Root-level leftovers from OLDER layouts ─────────────────────────
; Installs up to 2026-06-30 put llama-cpp-config.exe and llama.ico at the
; install ROOT; the tree then moved under bin\ and no uninstall looked there
; again, so that June copy survived every upgrade since. It also kept $INSTDIR
; alive, because the closing RMDir is non-recursive on purpose ($INSTDIR is
; user-chosen, and RMDir /r would follow a careless choice down a shared folder
; or a drive root). Hence an explicit list, and an entry may only be retired
; once no installed version can still have written it.
;
; Used from BOTH sides on purpose. The uninstaller is the obvious place, but on
; its own the cure would always arrive one generation late: an upgrade runs the
; uninstaller ALREADY on disk, which is the old buggy one, while the fixed one
; is merely written during that same install and does not run until the next.
; So the installer repeats the cleanup after the old uninstaller has had its
; turn, and trusts nothing it did. A macro rather than two copies, because two
; copies of a list whose whole job is to not forget an entry will drift.
!macro CleanLegacyRoot
    Delete "$INSTDIR\llama-cpp-config.exe"
    Delete "$INSTDIR\llama.ico"
    Delete "$INSTDIR\uninstall.exe"
!macroend

; ── Upgrade: remove previous installation silently ──────────────────
Function CheckPreviousInstall
    ReadRegStr $0 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" "UninstallString"
    StrCmp $0 "" done

    ReadRegStr $1 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" "DisplayVersion"
    MessageBox MB_YESNO|MB_ICONQUESTION \
        "llama.cpp-framework v$1 is already installed.$\n$\nUninstall the previous version before continuing?" \
        IDYES uninstall

    ; User chose No: abort
    Abort

    uninstall:
        ; Strip quotes from UninstallString
        StrCpy $2 $0 "" 1   ; remove first char (quote)
        StrLen $3 $2
        IntOp $3 $3 - 1
        StrCpy $2 $2 $3     ; remove last char (quote)
        ; `_?=` keeps the uninstaller from relocating to $TEMP, which is what
        ; makes ExecWait able to wait for it, and is also why it cannot delete
        ; itself: that is finished here, once ExecWait has returned and the
        ; image is no longer locked. Both layouts are cleared, because the
        ; installer being replaced may predate the move into bin\.
        ExecWait '"$2" /S _?=$INSTDIR'
        Delete "$INSTDIR\bin\llama-cpp-uninstall.exe"
        !insertmacro CleanLegacyRoot
        RMDir "$INSTDIR\bin"
        RMDir "$INSTDIR"
    done:
FunctionEnd

; ── Stop running processes before installation ──────────────────────
Function CheckAndStopProcesses
    ; Show confirmation dialog
    MessageBox MB_YESNO|MB_ICONQUESTION "Stop running processes?" IDYES check_and_stop IDNO abort

abort:
    Abort "Installation aborted by user."

check_and_stop:
    ; Read installation path from registry
    StrCpy $0 ""
    ReadRegStr $0 HKLM "Software\llama.cpp" "InstallDir"
    
    ; If not found, force kill anyway
    StrCmp $0 "" force_kill
    
    ; Build path to llama-cpp-config.exe
    StrCpy $1 "$0\bin\llama-cpp-config.exe"
    
    ; Check if file exists and execute stop-and-close command
    IfFileExists $1 have_exe
    force_kill:
        ; Force kill all llama processes
        nsExec::ExecToLog 'powershell -Command "Get-Process | Where-Object {$$_.ProcessName -like ''*llama-server*''} | Stop-Process -Force"'
        nsExec::ExecToLog 'powershell -Command "Get-Process | Where-Object {$$_.ProcessName -like ''*llama-cpp-config*''} | Stop-Process -Force"'
        goto done
    
    have_exe:
        ; Execute "llama-cpp-config.exe control stop-and-close" silently
        ExecWait '"$1" control stop-and-close'
        Sleep 1000

    ; Force kill any remaining processes
    nsExec::ExecToLog 'powershell -Command "Get-Process | Where-Object {$$_.ProcessName -like ''*llama-server*''} | Stop-Process -Force"'
    nsExec::ExecToLog 'powershell -Command "Get-Process | Where-Object {$$_.ProcessName -like ''*llama-cpp-config*''} | Stop-Process -Force"'

done:
FunctionEnd

; ── Main section: binaries ──────────────────────────────────────────
Section "llama.cpp binaries (required)" SecMain
    SectionIn RO

    SetOutPath "$INSTDIR\bin"
    File /r "@STAGING_DIR@\bin\*.*"

    SetOutPath "$INSTDIR\lib"
    File /nonfatal /r "@STAGING_DIR@\lib\*.*"

    ; llama-cpp-config (Rust GUI + CLI configurator), side-by-side with llama-server
    SetOutPath "$INSTDIR\bin"
    File "@STAGING_DIR@\llama-cpp-config.exe"
    File "@STAGING_DIR@\llama.ico"

    ; The ROCm kpack archives. Beside bin\, not in it: the dist's libraries
    ; look for them at <their own dir>\..\.kpack. Absent from a build without
    ; the HIP backend, hence /nonfatal.
    SetOutPath "$INSTDIR\.kpack"
    File /nonfatal /r "@STAGING_DIR@\.kpack\*.*"
    SetOutPath "$INSTDIR\bin"

    ; Installers up to 1.16 did not carry cuBLAS: a helper downloaded it into
    ; bin\, and an upgrade parked the pair here while the old uninstaller
    ; removed bin\. An upgrade cancelled halfway left it parked; the package
    ; ships its own copy now.
    RMDir /r "$INSTDIR\cublas-parked"

    ; Uninstaller. Lives in bin\ so the install root holds no FILE, only bin\,
    ; lib\ and .kpack\: a file at the root outlives every uninstall, because the Uninstall
    ; section's closing RMDir is non-recursive on purpose (see there).
    ;
    ; The name is namespaced rather than a bare `uninstall.exe` because bin\ is
    ; what the optional PATH component puts on the SYSTEM path: a generic
    ; `uninstall` command in every shell on the machine is the same mistake as
    ; shipping llama.cpp's `test*.exe`, which 03-package.ps1 prunes for exactly
    ; that reason.
    ;
    ; Self-deletion is not a problem in either launch mode. Run normally, an
    ; NSIS uninstaller copies itself to $TEMP and executes from there, so the
    ; `RMDir /r "$INSTDIR\bin"` that removes it is deleting a file nothing holds
    ; open. Run from CheckPreviousInstall with `_?=$INSTDIR`, that copy is
    ; suppressed by design (the caller has to be able to wait for it), so it
    ; cannot delete itself; there the caller finishes the job after ExecWait
    ; returns and the lock is gone.
    WriteUninstaller "$INSTDIR\bin\llama-cpp-uninstall.exe"

    ; Registry: Add/Remove Programs
    WriteRegStr HKLM "Software\llama.cpp" "InstallDir" "$INSTDIR"
    WriteRegStr HKLM "Software\llama.cpp" "LlamaBuild" "@LLAMA_BUILD@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "DisplayName" "llama.cpp-framework v@VERSION@ (llama @LLAMA_BUILD@)"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "UninstallString" "$\"$INSTDIR\bin\llama-cpp-uninstall.exe$\""
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "DisplayVersion" "@VERSION@"
    WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "Publisher" "llama.cpp"
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "NoModify" 1
    WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp" \
        "NoRepair" 1
SectionEnd

; ── Optional: Start Menu shortcut ────────────────────────────────────
Section "Start Menu shortcut" SecStartMenu
    CreateDirectory "$SMPROGRAMS\llama.cpp"
    CreateShortcut "$SMPROGRAMS\llama.cpp\llama.cpp Config.lnk" \
        "$INSTDIR\bin\llama-cpp-config.exe" "" "$INSTDIR\bin\llama.ico" 0
SectionEnd

; ── Optional: Add to PATH ──────────────────────────────────────────
Section "Add to system PATH" SecPath
    ; Use PowerShell to safely append to PATH (idempotent)
    nsExec::ExecToLog 'powershell -NoProfile -Command "\
        $$regKey = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey(\
            \"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\", $$true);\
        $$path = $$regKey.GetValue(\"Path\", \"\", \"DoNotExpandEnvironmentNames\");\
        $$dir = \"$INSTDIR\\bin\";\
        if (($$path -split \";\") -notcontains $$dir) {\
            $$regKey.SetValue(\"Path\", \"$$path;$$dir\", \"ExpandString\");\
        };\
        $$regKey.Close()"'
    ; Broadcast WM_SETTINGCHANGE so new shells pick up the change
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000
SectionEnd

; ── Section descriptions ────────────────────────────────────────────
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
    !insertmacro MUI_DESCRIPTION_TEXT ${SecMain} "llama.cpp binaries, the llama-cpp-config configurator and the bundled AMD ROCm and NVIDIA CUDA runtime libraries."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecStartMenu} "Create a Start Menu shortcut to llama-cpp-config."
    !insertmacro MUI_DESCRIPTION_TEXT ${SecPath} "Add llama.cpp bin directory to system PATH."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

; ── Uninstaller ─────────────────────────────────────────────────────
Section "Uninstall"
    ; Remove from PATH
    nsExec::ExecToLog 'powershell -NoProfile -Command "\
        $$regKey = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey(\
            \"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\", $$true);\
        $$path = $$regKey.GetValue(\"Path\", \"\", \"DoNotExpandEnvironmentNames\");\
        $$dir = \"$INSTDIR\\bin\";\
        $$newPath = ($$path -split \";\" | Where-Object { $$_ -ne $$dir }) -join \";\";\
        $$regKey.SetValue(\"Path\", $$newPath, \"ExpandString\");\
        $$regKey.Close()"'
    SendMessage ${HWND_BROADCAST} ${WM_SETTINGCHANGE} 0 "STR:Environment" /TIMEOUT=5000

    ; Files
    RMDir /r "$INSTDIR\bin"
    RMDir /r "$INSTDIR\lib"
    RMDir /r "$INSTDIR\.kpack"

    ; Root-level leftovers from older layouts (see the macro for the why).
    !insertmacro CleanLegacyRoot
    RMDir "$INSTDIR"

    ; Start Menu
    RMDir /r "$SMPROGRAMS\llama.cpp"

    ; Registry
    DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\llama.cpp"
    DeleteRegKey HKLM "Software\llama.cpp"

    ; User runtime config + per-model configs + logs.
    StrCpy $0 "$LOCALAPPDATA\llama.cpp"
    IfFileExists "$0\config\server.ini" 0 skip_user_data
    MessageBox MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2 \
        "Delete user configuration, per-model configs, and logs at $0?$\n$\nThis includes runtime settings and llama-server logs. Choose No to keep them for a future reinstall." \
        /SD IDNO IDNO skip_user_data
    RMDir /r "$0"
    skip_user_data:
SectionEnd
