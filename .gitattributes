# Patch files are consumed by `git apply` against LF sources: a CRLF
# checkout of one does not apply. Keep them byte-identical to upstream.
*.patch text eol=lf

# The benchmark prompts and specs are pinned by sha256 (a spec pins its
# prompts, standard.versions pins the spec), and a benchmark prompt that
# differs between two checkouts is two prompts. A CRLF checkout would change
# every line ending, hence the digest, hence the tokenization. Pin them to LF.
benchmarks/prompts/* text eol=lf
benchmarks/specs/* text eol=lf

# The icon font is compiled into the binary as is: never a text conversion.
*.ttf binary

# The Linux build scripts are run by bash straight from the checkout, also
# when the same working tree was checked out by Git for Windows on a drive
# both systems mount: a CRLF shebang line does not execute.
*.sh text eol=lf
