From 0400d98481f07e777801f2edcd60bb0f2ae4ea6a Mon Sep 17 00:00:00 2001
From: o7si <o7si@kanda-mashiro.cc>
Date: Fri, 30 Oct 2026 18:32:21 +0800
Subject: [PATCH] llama : fix MTP graph reallocations when switching inputs

---
 src/models/qwen35.cpp | 36 +++++++++++++++++++-----------------
 1 file changed, 19 insertions(+), 17 deletions(-)

diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index 5b05fc6..e9ca234 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -533,27 +533,29 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llm_graph_params & params)
     inp->embd = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_embd_inp(), n_tokens);
     ggml_set_input(inp->embd);
 
-    // TODO: make static using `ggml_build_forward_select()`
-    //       see llm_graph_context::build_inp_embd() for reference
-    ggml_tensor * tok_embd;
     ASSERT_EMBD_OR_TOKEN(ubatch);
-    if (ubatch.token) {
-        ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens : model.tok_embd;
-
-        tok_embd = ggml_get_rows(ctx0, tok_embd_w, inp->tokens);
-
-        // a Hadamard-latent table stores rotated rows; restore the primal basis
-        if (hdmd) {
-            if (const auto it = hdmd->inv.find(tok_embd_w); it != hdmd->inv.end()) {
-                tok_embd = llama_mul_mat_hadamard(ctx0, tok_embd, it->second.rot);
-                if (it->second.signs) {
-                    tok_embd = ggml_mul(ctx0, tok_embd, it->second.signs);
-                }
+    ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens : model.tok_embd;
+
+    ggml_tensor * tok_embd = ggml_get_rows(ctx0, tok_embd_w, inp->tokens);
+    ggml_build_forward_order(gf, tok_embd);
+
+    // a Hadamard-latent table stores rotated rows; restore the primal basis
+    if (hdmd) {
+        if (const auto it = hdmd->inv.find(tok_embd_w); it != hdmd->inv.end()) {
+            tok_embd = llama_mul_mat_hadamard(ctx0, tok_embd, it->second.rot);
+            if (it->second.signs) {
+                tok_embd = ggml_mul(ctx0, tok_embd, it->second.signs);
             }
         }
-    } else {
-        tok_embd = inp->embd;
     }
+
+    ggml_tensor * embd = inp->embd;
+    if (tok_embd_w->buffer && !ggml_backend_buffer_is_host(tok_embd_w->buffer)) {
+        embd = ggml_dup(ctx0, embd);
+    }
+
+    ggml_tensor * inps[] = { tok_embd, embd };
+    tok_embd = ggml_build_forward_select(gf, inps, 2, ubatch.token ? 0 : 1);
     cb(tok_embd, "mtp_tok_embd", il);
 
     inp->h = build_inp_embd_state(inp.get(), hparams.n_embd);
-- 
2.53.0

