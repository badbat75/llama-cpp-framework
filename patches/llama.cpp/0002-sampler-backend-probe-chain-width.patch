+// width of the candidate tensor after the first n_prefix samplers of a chain ran on the
+// backend, found by applying them to a probe graph of n_candidates logits
+static int64_t llama_sampler_chain_probe_width(
+        const std::vector<llama_sampler_chain::info> & samplers,
+        size_t                                         n_prefix,
+        int64_t                                        n_candidates) {
+    if (n_prefix == 0) {
+        return n_candidates;
+    }
+
+    const uint32_t max_nodes = GGML_DEFAULT_GRAPH_SIZE;
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ max_nodes * ggml_tensor_overhead() + ggml_graph_overhead_custom(max_nodes, false),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    if (!ctx_ptr) {
+        return n_candidates;
+    }
+
+    auto * ctx = ctx_ptr.get();
+    auto * gf = ggml_new_graph_custom(ctx, max_nodes, false);
+
+    // no candidates on input, as in the chain's own probe: the first sampler that narrows
+    // the set creates them (a top-p after a top-k expects the 1-D candidates top-k leaves)
+    llama_sampler_data data = {
+        /*.logits       =*/ ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_candidates),
+        /*.probs        =*/ nullptr,
+        /*.sampled      =*/ nullptr,
+        /*.candidates   =*/ nullptr,
+    };
+
+    for (size_t i = 0; i < n_prefix; i++) {
+        if (!samplers[i].is_backend) {
+            break;
+        }
+
+        auto * sampler = samplers[i].ptr;
+
+        if (sampler->iface->backend_reset) {
+            sampler->iface->backend_reset(sampler);
+        }
+        if (sampler->iface->backend_apply) {
+            sampler->iface->backend_apply(sampler, ctx, gf, &data);
+        }
+    }
+
+    return data.logits ? ggml_nelements(data.logits) : n_candidates;
+}
