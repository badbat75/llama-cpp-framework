+// The scheduler allocates llama's host-side compute buffers (the graph inputs: token ids, positions, the KQ mask;
+// the host copies of cross-backend tensors) from the host buffer type of the FIRST device, so only that device's
+// runtime has them pinned. Every other GPU runtime sees pageable memory and stages each input copy through its own
+// bounce buffer, blocking the calling thread for the whole copy; on Windows the HIP runtime does so at ~2 GB/s
+// (measured: 5.2 s of a 46 s prefill of 43.7k tokens with the R9700 placed second, the KQ masks above all).
+// Registering the same buffers with the other runtimes turns those copies into asynchronous DMA from pinned memory.
+void llama_context::sched_host_buffers_register(ggml_cgraph * gf) {
+    if (!gf || model.devices.size() < 2) {
+        return;
+    }
+
+    // the distinct host compute buffers the graph touches (the scheduler's, never a weight buffer)
+    std::vector<std::pair<void *, size_t>> cur;
+    auto collect = [&](const ggml_tensor * t) {
+        if (!t) {
+            return;
+        }
+        ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+        if (!buf || !ggml_backend_buffer_is_host(buf) || ggml_backend_buffer_get_usage(buf) != GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+            return;
+        }
+        void * base = ggml_backend_buffer_get_base(buf);
+        size_t size = ggml_backend_buffer_get_size(buf);
+        if (!base || !size) {
+            return;
+        }
+        for (const auto & [b, s] : cur) {
+            if (b == base) {
+                return;
+            }
+        }
+        cur.emplace_back(base, size);
+    };
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        collect(node);
+        for (int j = 0; j < GGML_MAX_SRC && node->src[j]; ++j) {
+            collect(node->src[j]);
+        }
+    }
+
+    // the usual case, once per ubatch: the same buffers as last time
+    if (cur == sched_host_cur) {
+        return;
+    }
+    sched_host_buffers_unregister();
+    sched_host_cur = cur;
+
+    // one registration per distinct runtime: two devices of one backend share a registry
+    std::vector<ggml_backend_reg_t> regs;
+    for (const auto & dev : model.devices) {
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev.dev);
+        if (reg && std::find(regs.begin(), regs.end(), reg) == regs.end()) {
+            regs.push_back(reg);
+        }
+    }
+
+    for (const auto & [base, size] : cur) {
+        for (auto * reg : regs) {
+            auto * fn = (bool (*)(void *, size_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer_rw");
+            if (!fn) {
+                continue;
+            }
+            // the runtime that allocated the buffer has it pinned already and refuses it: that is fine
+            if (fn(base, size)) {
+                sched_host_regs.emplace_back(reg, base);
+                LLAMA_LOG_DEBUG("%s: registered %.2f MiB of host compute buffer with %s\n", __func__,
+                        size / (1024.0*1024.0), ggml_backend_reg_name(reg));
+            }
+        }
+    }
+}
+
+void llama_context::sched_host_buffers_unregister() {
+    for (const auto & [reg, base] : sched_host_regs) {
+        auto * fn = (void (*)(void *)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer_rw");
+        if (fn) {
+            fn(base);
+        }
+    }
+    sched_host_regs.clear();
+    sched_host_cur.clear();
+}
+
 llm_graph_params llama_context::graph_params(
                         llm_graph_result * res,
                       const llama_ubatch & ubatch,
