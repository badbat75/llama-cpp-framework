+// read-write registration of a host buffer another runtime allocated, not gated by GGML_CUDA_REGISTER_HOST:
+// for the scheduler's host compute buffers (small, written by the host and by device-to-host copies)
+GGML_BACKEND_API bool ggml_backend_cuda_register_host_buffer_rw(void * buffer, size_t size);
+GGML_BACKEND_API void ggml_backend_cuda_unregister_host_buffer_rw(void * buffer);
