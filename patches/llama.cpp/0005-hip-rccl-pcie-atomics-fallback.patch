--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1229,6 +1229,21 @@
         return;
     }
 
+#ifdef GGML_USE_HIP
+    // RCCL's kernels take a hostcall buffer, and HIP refuses to dispatch those on a GPU whose
+    // PCIe link has no atomics (e.g. one behind a chipset): ncclGroupEnd then fails with
+    // hipErrorIllegalState. Detect it up front instead of aborting on the first allreduce.
+    for (int id : ret->dev_ids) {
+        int atomics = 0;
+        if (hipDeviceGetAttribute(&atomics, hipDeviceAttributeHostNativeAtomicSupported, id) == hipSuccess && !atomics) {
+            GGML_LOG_WARN("RCCL disabled: device %d has no PCIe atomics; "
+                          "falling back to internal AllReduce\n", id);
+            ggml_backend_cuda_comm_init_internal(ret);
+            return;
+        }
+    }
+#endif // GGML_USE_HIP
+
     const size_t n = ret->dev_ids.size();
     ret->comms.resize(n);
     ncclResult_t rc = ncclCommInitAll(ret->comms.data(), (int) n, ret->dev_ids.data());
