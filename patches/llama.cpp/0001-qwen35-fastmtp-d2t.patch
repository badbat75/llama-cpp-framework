+bool llama_model_qwen35::load_tensors(llama_model_loader & ml) {
+    if (!llama_model_base::load_tensors(ml)) {
+        return false;
+    }
+    if (d2t) {
+        // graph_mtp scatters the draft logits through d2t with ggml_set_rows: an
+        // entry outside the vocabulary would write past the logits, so refuse it
+        const int64_t n_vocab_full = vocab.n_tokens();
+        const int64_t n            = ggml_nelements(d2t);
+        std::vector<int64_t> idx(n);
+        if (d2t->type == GGML_TYPE_I64) {
+            ggml_backend_tensor_get(d2t, idx.data(), 0, ggml_nbytes(d2t));
+        } else {
+            std::vector<int32_t> idx32(n);
+            ggml_backend_tensor_get(d2t, idx32.data(), 0, ggml_nbytes(d2t));
+            for (int64_t i = 0; i < n; ++i) {
+                idx[i] = idx32[i];
+            }
+        }
+        for (int64_t i = 0; i < n; ++i) {
+            if (idx[i] < 0 || idx[i] >= n_vocab_full) {
+                throw std::runtime_error(format("d2t[%lld] = %lld is outside the vocabulary (%lld tokens)",
+                        (long long) i, (long long) idx[i], (long long) n_vocab_full));
+            }
+        }
+    }
+    return true;
+}
