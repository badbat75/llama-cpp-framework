+    // Same conditions as the GQA optimization of the mma kernel (ggml_cuda_flash_attn_ext_mma_f16_switch_ncols2):
+    if (!mask || mask->ne[2] != 1 || max_bias != 0.0f || K->ne[1] % FATTN_KQ_STRIDE != 0) {
+        return false;
+    }
+    for (const ggml_tensor * t : {Q, K, V, mask}) {
+        if (ggml_is_quantized(t->type)) {
+            continue;
+        }
+        for (size_t i = 1; i < GGML_MAX_DIMS; ++i) {
+            if (t->nb[i] % 16 != 0) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
