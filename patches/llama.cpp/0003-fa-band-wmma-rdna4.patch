+// RDNA4 decode/verify band (opt-in, GGML_HIP_FA_BAND_WMMA = 2 or 4, 0/unset = off):
+// small batches (Q->ne[1] <= 8) with head size 256 and a GQA ratio in (4, GGML_HIP_FA_BAND_WMMA_GQA_MAX] go to
+// the mma kernel with the GQA group folded into one block (ncols2 = 8) instead of the tile kernel, which reads
+// K/V once per 2 or 4 Q heads (ncols2 = the largest power of two dividing the ratio, at most 8). The env value
+// is ncols1 for the whole band so that every batch width runs the same kernel configuration. Quantized K/V is
+// still converted to f16 by launch_fattn before the kernel.
+static inline int ggml_cuda_fattn_band_wmma_ncols1() {
+    static const int ncols1 = []() {
+        const char * env = getenv("GGML_HIP_FA_BAND_WMMA");
+        const int v = env ? atoi(env) : 0;
+        return v == 2 || v == 4 ? v : 0;
+    }();
+    return ncols1;
+}
+
+// Number of blocks P per output tile in the band, 0 = one per SM (nsm). GGML_HIP_FA_BAND_WMMA_SPLIT overrides it.
+// P must not depend on Q->ne[1] or on the KV length, otherwise different batch widths reduce differently.
+static inline int ggml_cuda_fattn_band_wmma_split() {
+    static const int split = []() {
+        const char * env = getenv("GGML_HIP_FA_BAND_WMMA_SPLIT");
+        const int v = env ? atoi(env) : 0;
+        return v > 0 ? v : 0;
+    }();
+    return split;
+}
+
+// Largest GQA ratio the band folds, GGML_HIP_FA_BAND_WMMA_GQA_MAX (default 12, values below 8 read as 8).
+// A ratio above 8 takes ceil(gqa_ratio/8) KV passes: the mma kernel loads a partial final group of 8 and masks
+// its unused columns (flash_attn_ext_f16_process_tile masks the Q load and the dst write on
+// zt_gqa*ncols2 + c < gqa_ratio, and launch_fattn and the fixup tile the ratio with the same ceil). That is still
+// fewer passes than the tile kernel's ceil(gqa_ratio/ncols2_tile): 2 instead of 3 for the ratio 12 of
+// Qwen3.8-Flash-Next (qwen4exp, 24 heads over 2 KV heads, where the tile kernel folds 4 heads). At 1 query the
+// wider tile pays for the columns a decode leaves unused, so a short context loses a few percent while a deep
+// one gains the two KV reads saved; 8 restores the whole-group fold alone.
+static inline int ggml_cuda_fattn_band_wmma_gqa_max() {
+    static const int gqa_max = []() {
+        const char * env = getenv("GGML_HIP_FA_BAND_WMMA_GQA_MAX");
+        const int v = env ? atoi(env) : 12;
+        const int gqa_max = v > 8 ? v : 8;
+        // Reached on the first head-256 attention call with the band enabled: the one line that says it is live.
+        GGML_LOG_INFO("%s: RDNA4 FA band enabled: ncols1 = %d, GQA ratios up to %d\n", __func__,
+            ggml_cuda_fattn_band_wmma_ncols1(), gqa_max);
+        return gqa_max;
+    }();
+    return gqa_max;
+}
+
+// Kernel selection, the mma ncols dispatch and launch_fattn must agree on the band, so all of them ask this.
+static bool ggml_cuda_fattn_band_wmma_applies(const int cc, const ggml_tensor * dst) {
+    if (ggml_cuda_fattn_band_wmma_ncols1() == 0 || !GGML_CUDA_CC_IS_RDNA4(cc) || !amd_wmma_available(cc)) {
+        return false;
+    }
+
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (Q->ne[0] != 256 || V->ne[0] != 256 || Q->ne[1] > 8 || Q->ne[3] != 1 || logit_softcap != 0.0f) {
+        return false;
+    }
+    if (!(K->type == GGML_TYPE_F16 || K->type == GGML_TYPE_Q8_0) || V->type != K->type) {
+        return false;
+    }
+    if (Q->ne[2] % K->ne[2] != 0) {
+        return false;
+    }
+    const int gqa_ratio = Q->ne[2] / K->ne[2];
+    if (gqa_ratio <= 4 || gqa_ratio > ggml_cuda_fattn_band_wmma_gqa_max()) {
+        return false;
+    }
