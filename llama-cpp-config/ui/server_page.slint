// ServerPage: the server tab. All state lives in AppState (state.slint); this
// component just lays out the widgets against it.
//
// Layout (grep `heading:`): Network → Resources → GPU distribution → Tensor
// placement → Advanced → SDK Tuning cards, then the FormActions row
// (Save/Revert), then the Command Line card
// last. The Command
// Line card auto-sizes to its content (a hidden mirror-Text drives its height) so
// it never shows its own inner scrollbar; the page's own ScrollView handles it.
//
// SDK Tuning is the one card that holds no llama-server flags: its fields are
// vendor-library environment variables (`runstate::env_vars`), so they are split
// per GPU SDK: a knob there is read by the backend's own libraries, never by
// llama.cpp, and is inert on every other backend.
//
// Editable widgets bind two-way (`<=>`): a one-way binding breaks the moment the
// user types/toggles (Slint's "overwritten bindings" rule), which would leave the
// field stale after a Revert / reload.

import { LineEdit, TextEdit, CheckBox, Button, ScrollView, Palette } from "std-widgets.slint";
import { SectionCard, LabeledField, SegmentedControl, MappedComboBox, EnumComboBox, AutoSlider, DefaultLineEdit, FormActions, GpuSplitTable, TensorOverrideTable, WrapText, LabelColumn, Tokens, Options } from "components.slint";
import { AppState } from "state.slint";

export component ServerPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Server";
            font-size: 22px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: "Machine-wide llama-server settings (server.ini). Per-model knobs live under Models.";
            color: Palette.foreground.transparentize(Tokens.muted);
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionCard {
            heading: "Network";
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Port";
                hint: "TCP port llama-server listens on (--port).\ndefault = omit the flag → llama.cpp default: 8080. The chat UI and integrations connect here.";
                DefaultLineEdit {
                    edit_label: "server-port";
                    input_type: InputType.number;
                    default <=> AppState.server_form.port_default;
                    value <=> AppState.server_form.port;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Bind to";
                hint: "Addresses to listen on (--host); check one or more, each is bound on its own.\nlocalhost = this PC only; 0.0.0.0 = all interfaces, reachable from the LAN, and exclusive: it already covers every other row, so checking it clears them.\nThe chat UI and integrations connect to a loopback address when one is checked, otherwise to the first one.";
                // One-way `checked`, same contract as the Benchmark tab's preset
                // rows: the click self-assigns and breaks THIS delegate's
                // binding, which stays invisible because every toggle rebuilds
                // the model (gui/server_tab.rs `bind_toggle`).
                VerticalLayout {
                    spacing: 2px;
                    for row in AppState.bind_rows : CheckBox {
                        text: row.label;
                        accessible-label: "bind-" + row.value;
                        enabled: row.enabled;
                        checked: row.checked;
                        toggled => { AppState.bind_toggle(row.value); }
                    }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Base URL";
                hint: "Base URL for integrations (opencode.json + Claude Code).\nDefault = auto from host+port (/v1 appended for opencode.json). Uncheck to override for proxy/gateway.";
                DefaultLineEdit {
                    edit_label: "server-base-url";
                    input_type: InputType.text;
                    default <=> AppState.server_form.base_url_default;
                    value <=> AppState.server_form.opencode_base_url;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "API Key";
                hint: "Authentication key for the integration provider.\nNo key = none. Used when behind a proxy or LLM gateway that requires an API key.";
                HorizontalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "No key";
                        checked <=> AppState.server_form.api_key_nokey;
                    }
                    LineEdit {
                        enabled: !AppState.server_form.api_key_nokey;
                        text <=> AppState.server_form.opencode_api_key;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        SectionCard {
            heading: "Resources";
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "CPU threads";
                hint: "--threads: CPU threads for generation.\ndefault = omit the flag → llama.cpp auto-detects the physical-core count. More won't help once GPU-bound. Max = logical processors.";
                AutoSlider {
                    auto <=> AppState.server_form.threads_auto;
                    value <=> AppState.server_form.threads;
                    maximum: AppState.cpu_threads_max;
                    slider_label: "server-threads";
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Batch threads";
                hint: "--threads-batch: CPU threads for prompt processing (prefill).\ndefault = omit the flag → llama.cpp defaults to the same as --threads. Max = logical processors.";
                AutoSlider {
                    auto <=> AppState.server_form.threads_batch_auto;
                    value <=> AppState.server_form.threads_batch;
                    maximum: AppState.cpu_threads_max;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Max models";
                hint: "--models-max: how many preset models llama-server keeps resident at once.\n1 = load one at a time (lowest VRAM); higher lets it hot-swap without reloading.\ndefault = omit the flag → llama.cpp default: 4.\n0 = unlimited.";
                DefaultLineEdit {
                    input_type: InputType.number;
                    default <=> AppState.server_form.models_max_default;
                    value <=> AppState.server_form.models_max;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Models folder";
                hint: "Root folder scanned for GGUFs.\nPickers read its subfolders: models\\, mmprojs\\, mtps\\, dflashs\\.";
                LineEdit {
                    text <=> AppState.server_form.models_dir;
                    placeholder-text: "root dir (models\\ and mmprojs\\ underneath)";
                }
                Button {
                    text: "Browse…";
                    clicked => {
                        AppState.server_form.models_dir = AppState.browse_dir(AppState.server_form.models_dir);
                    }
                }
            }
        }

        SectionCard {
            heading: "Advanced";
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Web UI MCP proxy";
                hint: "Enable the built-in chat UI's MCP CORS proxy (--webui-mcp-proxy).\nThe bundled chat UI needs it to call MCP tools. Experimental upstream; don't enable on an untrusted network.\ndefault = on.";
                CheckBox {
                    text: "serve the web UI's MCP proxy endpoint";
                    checked <=> AppState.server_form.webui_mcp_proxy;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Log level";
                hint: "llama-server log verbosity threshold (-lv / --log-verbosity): a message is printed when its own level is ≤ this one, so DEBUG:5 shows everything and OUTPUT:0 almost nothing.\nllama.cpp defines exactly these six levels; the number after the colon is what is passed to -lv.\nFramework default TRACE:4 records per-request logging into logs/llama-server.log; DEBUG:5 also logs the per-tensor override lines that tools\\report-memory.ps1 reads.";
                // A dropdown, not a number: the six levels are the whole domain
                // (see Options.log_levels), and the form carries the LABEL.
                EnumComboBox {
                    options: Options.log_levels;
                    value <=> AppState.server_form.log_verbosity;
                }
            }
        }

        SectionCard {
            heading: "Conversation snapshots";
            Text {
                text: "Write each loaded model's KV cache to disk when the server stops, and push the newest one back on the next start. It buys back the one cost no VRAM tuning touches: reading a prompt is quadratic in its length and the cache dies with the process, so a restart re-reads the whole conversation. A 234k-token prompt costs about 17 minutes of prefill against roughly 8 GiB of sequential disk IO. Off by default: every snapshot costs that much disk, stopping waits for the write, and the next start loads the model eagerly to push the state back in.";
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Save on shutdown";
                hint: "Dump the running conversation to the snapshot folder when llama-server stops (--slot-save-path plus a /slots save call), and restore it at the next start.\nOne file per loaded model, overwritten each time; dumps of models that are no longer loaded are pruned.\nWorth it for long agentic sessions, pointless for short prompts.\ndefault = off.";
                CheckBox {
                    text: "snapshot the KV cache on stop and restore it on start";
                    checked <=> AppState.server_form.save_state_on_shutdown;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Snapshot folder";
                hint: "Where the dumps go. A snapshot is roughly one byte per byte of KV cache, and it scales with the tokens actually in the conversation, NOT with ctx-size: measured 4.4 GiB for a 127k-token conversation on a 27B model, where a full 262k context would be about 8.3 GiB.\nThe default sits under %LOCALAPPDATA%, on the system drive; point it at a data disk if C: is tight.\nThe folder is created at launch: llama.cpp refuses to start on a --slot-save-path it cannot find.";
                LineEdit {
                    text <=> AppState.server_form.state_dir;
                    enabled: AppState.server_form.save_state_on_shutdown;
                    placeholder-text: "folder for the KV-cache dumps";
                }
                Button {
                    text: "Browse…";
                    enabled: AppState.server_form.save_state_on_shutdown;
                    clicked => {
                        AppState.server_form.state_dir = AppState.browse_dir(AppState.server_form.state_dir);
                    }
                }
            }
        }

        SectionCard {
            heading: "SDK Tuning";
            Text {
                text: "Environment variables of the GPU vendor's own libraries, exported onto llama-server at launch (its per-model children inherit them). They are not llama.cpp flags: nothing validates them, and each one is read only by the backend it belongs to, inert on the others. The Command Line card below shows exactly what gets exported.";
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }

            Text {
                text: "CUDA";
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
            }
            Text {
                text: "Nothing to tune. The cuBLAS path needs no environment workaround on the builds this framework ships.";
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }

            Text {
                text: "ROCm";
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
            }
            // The HIP backend is the one that disappears without saying so:
            // ggml drops a backend whose imports don't resolve in silence, and
            // the same AMD card keeps working through Vulkan at a fraction of
            // the speed. Nothing else in the UI would report it, so this strip
            // is the only place it surfaces. WrapText, not Text: inside a
            // component a wrapped Text publishes a one-line height and paints
            // over what follows.
            if AppState.rocm_warning != "" : WrapText {
                text: AppState.rocm_warning;
                font_size: 12px;
                color: Tokens.err;
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "hipBLASLt";
                hint: "ROCBLAS_USE_HIPBLASLT: which of its two GEMM backends rocBLAS uses. Read by rocBLAS itself, so it rides the environment; there is no llama-server flag for it.\ndefault = don't set the variable: rocBLAS routes as it sees fit, which on RDNA4 means hipBLASLt for 16-bit GEMMs.\non forces hipBLASLt (=1); off forces Tensile (=0).\nSet it off on a Radeon AI PRO R9700 (gfx1201): hipBLASLt fails the SECOND 16-bit GEMM of a process there, so every BF16/F16 model aborts on its first prefill batch. Tensile costs nothing: measured pp512 587 t/s, tg128 35 t/s on Ornith BF16, where the older f32-compute workaround managed 19 t/s prefill. Upstream: ROCm issue #6461.\nYou may not need it at all: hipBLASLt only fails against the DRIVER's HIP runtime, the copy Windows loads from System32 in preference to anything on PATH. The installer puts ROCm's own runtime next to llama-server.exe, and the same GEMMs then pass with hipBLASLt on; only a build from source still runs the driver's.\nNo effect on CUDA or Vulkan builds.";
                // TRI-state, not a checkbox: unset (never export the variable)
                // is a third instruction, and it is the framework default,
                // same reason as the preset tab's Flash Attention control
                // (form.rs's tri_state / tri_bool). A dropdown like the
                // AllReduce one below, so the card's two knobs read alike.
                EnumComboBox {
                    options: Options.tri_states;
                    value <=> AppState.server_form.rocblas_use_hipblaslt;
                }
            }

            Text {
                text: "CUDA and ROCm";
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
            }
            LabeledField {
                label_width <=> LabelColumn.server;
                label: "Tensor-split AllReduce";
                hint: "GGML_CUDA_ALLREDUCE: how split-mode tensor sums the partial results of the GPUs in the split. Read by the CUDA and the ROCm backend alike (one variable, one value for both), server-wide, and inert in every other split mode.\ndefault = don't set the variable: on Linux the collective library when the build links one (RCCL for ROCm devices), then the internal AllReduce; on Windows the internal one.\nnccl = the collective library (RCCL on ROCm; NCCL on CUDA only where the build found it).\ninternal = ggml's own AllReduce, staged through pinned host memory, so the slower card's PCIe link bounds it.\nnone = the generic reduction of llama.cpp's meta backend.\nSet it to none for a tensor split that MIXES a CUDA and a ROCm device: under any other value that model aborts while loading (measured on v0.6.0). On such a pair tensor then prefills at about half the speed of the layer split and decodes the same.";
                EnumComboBox {
                    options: Options.allreduce_modes;
                    value <=> AppState.server_form.cuda_allreduce;
                }
            }
        }

        FormActions {
            save_text: "Save changes";
            // Shared with the Ctrl+S shortcut; the gate lives in state.slint.
            save_enabled: AppState.can_save_server;
            revert_enabled: AppState.server_dirty;
            save => { AppState.save_server(); }
            revert => { AppState.revert_server(); }
        }

        SectionCard {
            heading: "Command Line";
            content_padding: 12px;
            // Read-only, multi-line view of the exact llama-server
            // invocation `Start` would run. Rust formats it one
            // `--flag value` per line, joined with the shell's
            // line-continuation char (`` ` `` on Windows, `\` on
            // POSIX), so it pastes straight into a terminal.
            //
            // Auto-height: the box sizes to a hidden mirror Text that wraps the
            // same string, so the whole command shows at once with no inner
            // scrollbar (the page's own ScrollView handles overflow). It stays a
            // read-only TextEdit, not a plain Text, so the command remains
            // selectable/copyable (Ctrl+C), the same reason the chat-template
            // preview is a TextEdit (app.slint). Neither the mirror nor the
            // TextEdit sets a font, so both render at the same default metrics
            // and the mirror's height matches the TextEdit's wrapped content.
            Rectangle {
                // Height tracks the wrapped content so the box never shows its
                // own scrollbar (it re-derives only on Save/Revert/load, when the
                // command string itself changes). The mirror Text (12px narrower
                // per side) wraps at least as often as the TextEdit's text area,
                // so it can only OVER-count lines; then +48px clears the
                // TextEdit's border + top/bottom padding, which measured ~one text
                // line taller than the bare mirror (a +24px buffer left the box
                // one line short, so the scrollbar came back).
                height: mirror.preferred-height + 48px;
                mirror := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: AppState.server_command_line;
                    wrap: word-wrap;
                    visible: false;
                }
                TextEdit {
                    width: 100%;
                    height: 100%;
                    text: AppState.server_command_line;
                    read-only: true;
                    wrap: word-wrap;
                }
            }
        }
    }
}
