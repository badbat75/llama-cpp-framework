// IntegrationsPage: the integrations tab. All state lives in AppState (state.slint).
//
// Layout (grep `heading:`): OpenCode (status + buttons) → Claude Code card.
// There is no model list: OpenCode lists every ENABLED preset, i.e. the switch
// beside each preset in the Models tab (see src/integrations.rs).

import { LineEdit, Button, ScrollView, Palette } from "std-widgets.slint";
import { SectionCard, Tokens } from "components.slint";
import { AppState } from "state.slint";
import { Strings } from "strings.slint";

export component IntegrationsPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: Strings.t("integrations");
            font-size: 22px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: Strings.t("integrations-intro");
            color: Palette.foreground.transparentize(Tokens.muted);
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionCard {
            heading: "OpenCode";
            Text {
                text: Strings.t("opencode-intro");
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }
            // Directly in the card, not inside a LabeledField: the status can
            // wrap (it names ids when the file drifts), and a wrapping Text is
            // sized correctly only when no component boundary sits between it
            // and the card (see WrapText in components.slint).
            Text {
                text: AppState.integration_status;
                color: !AppState.integration_provider_active
                    ? Palette.foreground.transparentize(Tokens.muted)
                    : (AppState.integration_in_sync ? Tokens.ok : Tokens.err);
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: Strings.t("save");
                    clicked => { AppState.save_integrations(); }
                }
                Button {
                    text: Strings.t("open");
                    clicked => { AppState.open_opencode_folder(); }
                }
            }
        }

        SectionCard {
            heading: "Claude Code";
            content_padding: 12px;
            Text {
                text: Strings.t("claude-code-intro");
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }
            LineEdit {
                text: AppState.integration_claude_env;
                read-only: true;
                font-size: 11px;
                horizontal-stretch: 1;
            }
        }
    }
}
