                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-m-gram");
                    hint: Strings.t("ngram-simple-draft-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-simple");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_simple_size_m_default;
