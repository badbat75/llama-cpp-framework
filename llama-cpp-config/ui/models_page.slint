                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("unified-kv");
                    hint: Strings.t("unified-kv-hint");
                    // TRI-state like Flash Attention: "default" is its own
                    // instruction (mapped to Option<bool> in form.rs).
                    SegmentedControl {
                        enabled: !AppState.form.parallel_default;
                        options: ["default", "on", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.kv_unified == "" ? "default" : AppState.form.kv_unified;
                        activated(value) => { AppState.form.kv_unified = value; }
                    }
