                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("per-slot-context");
                    hint: Strings.t("per-slot-context-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.kv_unified_per_slot_default;
                        value <=> AppState.form.kv_unified_per_slot;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("batch-size");
                    hint: Strings.t("batch-size-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.batch_size_default;
                        value <=> AppState.form.batch_size;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("u-batch-size");
                    hint: Strings.t("u-batch-size-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.ubatch_size_default;
                        value <=> AppState.form.ubatch_size;
                    }
