// ModelsPage: the models tab (preset editor). All state lives in AppState
// (state.slint); this component lays out the widgets against it.
//
// Layout: preset list (left column) | editor cards (right, grep `heading:`):
// Assets → Model info → GPU distribution → Hardware Config → Resource / context →
// KV cache → Chat / reasoning → Sampling overrides → Advanced →
// Vision → Speculative decoding, then the FormActions row.

import { LineEdit, ComboBox, CheckBox, Button, ListView, ScrollView, Switch, Palette } from "std-widgets.slint";
import { SectionCard, LabeledField, InfoRow, SegmentedControl, MappedComboBox, EnumComboBox, AutoSlider, DefaultLineEdit, FormActions, SelectableRow, ListPanel, GpuSplitTable, TensorOverrideTable, LabelColumn, Tokens, Options, WrapText } from "components.slint";
import { AppState } from "state.slint";
import { Strings } from "strings.slint";

// The draft-model entry of `form.spec_type` (AppState.spec_type_drafter): a
// one-way read of the list, written back through `spec_type_with_drafter` so
// the ngram-* entries survive. Same index sync as EnumComboBox: the click
// self-assigns `current-index`, and `changed shown` puts it back whenever the
// list changes from elsewhere (preset switch, Revert, the draft-file picker).
// A drafter not in `options` (draft-eagle3) shows "none" and round-trips
// until another one is picked.
component SpecDrafterComboBox inherits ComboBox {
    in property <[string]> options;
    in property <[string]> labels;
    property <string> drafter: AppState.spec_type_drafter(AppState.form.spec_type);
    property <int> shown: root.drafter == root.options[1] ? 1
        : root.drafter == root.options[2] ? 2
        : root.drafter == root.options[3] ? 3
        : root.drafter == root.options[4] ? 4
        : 0;
    model: root.labels;
    current-index: root.shown;
    selected => {
        AppState.form.spec_type = AppState.spec_type_with_drafter(AppState.form.spec_type, root.options[self.current-index]);
    }
    changed shown => {
        if (self.current-index != root.shown) {
            self.current-index = root.shown;
        }
    }
}

// One ngram-* entry of `form.spec_type`, ticked when the list names it. The
// click self-assigns `checked` and breaks a plain binding, so `changed listed`
// pushes the list's verdict back instead.
component SpecNgramCheckBox inherits CheckBox {
    in property <string> entry;
    property <bool> listed: AppState.spec_type_has(AppState.form.spec_type, root.entry);
    text: root.entry;
    checked: root.listed;
    toggled => {
        AppState.form.spec_type = AppState.spec_type_with_ngram(AppState.form.spec_type, root.entry, self.checked);
    }
    changed listed => {
        if (self.checked != root.listed) {
            self.checked = root.listed;
        }
    }
}

export component ModelsPage inherits HorizontalLayout {
    padding: 24px;
    spacing: 16px;

    // Left column: preset list
    VerticalLayout {
        width: 240px;
        spacing: 10px;

        Text {
            text: Strings.t("presets");
            font-size: 14px;
            font-weight: 600;
            color: Palette.foreground;
        }

        LineEdit {
            placeholder-text: Strings.t("filter-presets");
            input-type: search;
            text <=> AppState.presets_filter;
            edited(t) => { AppState.filter_presets(t); }
        }

        ListPanel {
            is_empty: AppState.presets.length == 0;
            empty_text: AppState.presets_filter == ""
                ? Strings.t("no-presets-yet")
                : Strings.t("no-presets-match");
            // Keep the floor modest so the Models tab still fits a
            // small screen; vertical-stretch grows it on big ones.
            min-height: 160px;
            vertical-stretch: 1;
            ListView {
                // The Rust side already filtered out non-matching rows, so every
                // delegate is a fixed 36px tall; a data-dependent height confuses
                // ListView's running-sum layout and the rows render on top of each
                // other. `p.orig_index` maps back to the full presets vector.
                for p in AppState.presets : SelectableRow {
                    height: 36px;
                    label: p.id;
                    muted: !p.enabled;
                    selected: p.orig_index == AppState.selected_preset_index;
                    clicked => { AppState.select_preset(p.orig_index); }
                    // On = the section sits in presets.ini, so llama-server (and
                    // OpenCode) offer it; off = parked in presets.ini.disabled.
                    // Sanctioned one-way binding, the GPU table's contract: a
                    // click self-assigns `checked`, breaking THIS delegate's
                    // binding, and the handler always replaces the whole list
                    // model (gui::refresh_preset_list), failure included, so the
                    // delegates that show it are fresh ones.
                    Switch {
                        // Findable handle for the e2e flow (src/tests/save_flow.rs).
                        accessible-label: "enabled-" + p.id;
                        checked: p.enabled;
                        toggled => { AppState.toggle_preset_enabled(p.id, self.checked); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: Strings.t("new-dialog");
                    clicked => { AppState.new_preset(); }
                }
                Button {
                    text: Strings.t("clone-dialog");
                    enabled: AppState.selected_preset_index >= 0;
                    clicked => { AppState.clone_preset(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: Strings.t("rename-dialog");
                    enabled: AppState.selected_preset_index >= 0;
                    // Routes through Rust like New…/Clone… so a dirty form gets
                    // the discard-confirm guard before the dialog opens; the
                    // actual rename then fires from the dialog in app.slint
                    // (AppState.rename_preset).
                    clicked => { AppState.request_rename(); }
                }
                Button {
                    text: Strings.t("delete");
                    enabled: AppState.selected_preset_index >= 0;
                    // Confirmation modal (app.slint), opened by Rust because
                    // it lists the model files the preset links, which the
                    // user may delete with it (gui/models_tab.rs). The
                    // delete is one INI rewrite (plus those files) with no undo.
                    clicked => { AppState.request_delete(); }
                }
            }
        }

        Text {
            text: Strings.t("preset-off-note");
            font-size: 10px;
            color: Palette.foreground.transparentize(Tokens.faint);
            wrap: word-wrap;
        }

        Text {
            text: AppState.presets_path;
            font-size: 10px;
            color: Palette.foreground.transparentize(Tokens.faint);
            wrap: word-wrap;
        }
    }

    // Right column: editor
    ScrollView {
        horizontal-stretch: 1;
        VerticalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 16px;

            Text {
                text: AppState.selected_preset_index >= 0
                    ? Strings.t1("preset-id-heading", AppState.form.id)
                    : Strings.t("no-preset-selected");
                font-size: 14px;
                font-weight: 600;
                color: Palette.foreground;
            }

            SectionCard {
                heading: Strings.t("assets");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("model-file");
                    hint: Strings.t("model-file-hint");
                    MappedComboBox {
                        labels: AppState.model_labels;
                        values: AppState.model_values;
                        index <=> AppState.model_index;
                        picked(v) => {
                            AppState.form.model = v;
                            AppState.model_changed();
                        }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("project-url");
                    hint: Strings.t("project-url-hint");
                    LineEdit {
                        text <=> AppState.form.project_url;
                        placeholder-text: "e.g. https://huggingface.co/<org>/<repo>";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: Strings.t("open");
                        // Web pages only: the value is free text, and the desktop
                        // opener would run anything else it is handed.
                        enabled: AppState.form.project_url.starts-with("https://")
                            || AppState.form.project_url.starts-with("http://");
                        clicked => { Platform.open-url(AppState.form.project_url); }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: "MMProj";
                    hint: Strings.t("mmproj-hint");
                    MappedComboBox {
                        labels: AppState.mmproj_labels;
                        values: AppState.mmproj_values;
                        index <=> AppState.mmproj_index;
                        picked(v) => {
                            AppState.form.mmproj = v;
                            AppState.model_changed();
                        }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-model");
                    hint: Strings.t("draft-model-hint");
                    // A raw ComboBox (not MappedComboBox): the handler needs the
                    // selected INDEX to read the Rust-side `State.draft_rows`
                    // cache (the per-row --model-draft/--spec-type pairs), not
                    // just the picked value. The pick POLICY (spec-type + the
                    // gemma4 auto-pin workaround) lives in Rust; see the
                    // `draft_picked` handler in src/gui/models_tab.rs.
                    ComboBox {
                        model: AppState.draft_labels;
                        current-index <=> AppState.draft_index;
                        selected => { AppState.draft_picked(self.current-index); }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("drafter");
                    hint: Strings.t("drafter-hint");
                    SpecDrafterComboBox {
                        // draft-dspark sits next to draft-dflash: same arch,
                        // same dflashs\ folder, told apart only by the Markov head.
                        enabled: AppState.draft_active;
                        options: AppState.draft_active
                            ? ["none", "draft-mtp", "draft-dflash", "draft-dspark", "draft-simple"]
                            : ["none"];
                        labels: AppState.draft_active
                            ? [Strings.t("none"), "draft-mtp", "draft-dflash", "draft-dspark", "draft-simple"]
                            : [Strings.t("none")];
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("n-gram-drafters");
                    hint: Strings.t("n-gram-drafters-hint");
                    // Always active (presets::spec_type_is_draftless). llama.cpp's
                    // ngram-cache is left out: its draft length is fixed at 8 and
                    // the server never saves its lookup caches. A preset naming it
                    // keeps it in the list, untouched.
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        SpecNgramCheckBox { entry: "ngram-mod"; }
                        SpecNgramCheckBox { entry: "ngram-simple"; }
                        SpecNgramCheckBox { entry: "ngram-map-k"; }
                        SpecNgramCheckBox { entry: "ngram-map-k4v"; }
                    }
                }
            }

            SectionCard {
                heading: Strings.t("model-info");
                if AppState.model_info_ready : VerticalLayout {
                    spacing: 8px;
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("type");
                        hint: Strings.t("type-hint");
                        value: AppState.model_info_kind;
                    }
                    if AppState.model_info_has_moe : InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("moe-layers");
                        hint: Strings.t("moe-layers-hint");
                        value: AppState.model_info_moe;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("arch-quant");
                        value: AppState.model_info_arch_quant;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("embeddings");
                        hint: Strings.t("embeddings-hint");
                        value: AppState.model_info_embd;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("layers-ctx");
                        hint: Strings.t("layers-ctx-hint");
                        value: AppState.model_info_layers_ctx;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("attention");
                        hint: Strings.t("attention-hint");
                        value: AppState.model_info_attn;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("memory");
                        hint: Strings.t("memory-hint");
                        value: AppState.model_info_memory;
                    }
                    // A LabeledField (not InfoRow) so the body can hold BOTH a
                    // status Text and a Preview button: LabeledField forwards
                    // @children into its row layout, InfoRow fills that slot
                    // with its own Text. The button opens a modal showing the
                    // raw template; it's hidden when no template is embedded.
                    LabeledField {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("chat-template");
                        hint: Strings.t("chat-template-hint");
                        Text {
                            text: AppState.model_info_chat_template;
                            vertical-alignment: center;
                            font-size: 13px;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }
                        if AppState.chat_template_preview != "" : Button {
                            text: Strings.t("preview");
                            clicked => { AppState.show_chat_template_dialog = true; }
                        }
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("thinking");
                        hint: Strings.t("thinking-hint");
                        value: AppState.model_info_thinking;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("past-thinking");
                        hint: Strings.t("past-thinking-hint");
                        value: AppState.model_info_past_thinking;
                    }
                    if AppState.model_info_has_mmproj : InfoRow {
                        label_width <=> LabelColumn.models;
                        label: "MMProj";
                        hint: Strings.t("selected-mmproj-hint");
                        value: AppState.model_info_mmproj;
                    }
                    InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("draft");
                        hint: Strings.t("draft-hint");
                        value: AppState.model_info_draft;
                    }
                    if AppState.model_info_has_draft_file : InfoRow {
                        label_width <=> LabelColumn.models;
                        label: Strings.t("draft-file");
                        hint: Strings.t("draft-file-hint");
                        value: AppState.model_info_draft_file;
                    }
                }
                if !AppState.model_info_ready : Text {
                    text: AppState.model_info_note == ""
                        ? Strings.t("no-model-selected")
                        : AppState.model_info_note;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
            }

            SectionCard {
                heading: Strings.t("gpu-distribution");
                Text {
                    text: Strings.t("gpu-distribution-intro");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                // The download's estimate behind this placement (a `; placement =`
                // comment): read-only, Clear drops it once the values are tuned.
                if AppState.form.placement_note != "": HorizontalLayout {
                    spacing: 8px;
                    WrapText {
                        text: Strings.t1("placement-note", AppState.form.placement_note);
                        font_size: 12px;
                        color: Palette.foreground.transparentize(Tokens.muted);
                    }
                    Button {
                        text: Strings.t("clear");
                        vertical-stretch: 0;
                        clicked => { AppState.form.placement_note = ""; }
                    }
                }
                GpuSplitTable {
                    label_width <=> LabelColumn.models;
                    rows: AppState.preset_gpu_rows;
                    selected: AppState.preset_gpu_selected;
                    weight_total: AppState.preset_gpu_total;
                    // Non-zero once the model's header is read AND the effective
                    // mode is layer: the table then edits BLOCKS instead of
                    positions: AppState.preset_split_positions;
                    // Split mode tensor's load-time refusals, against this
                    // preset's mode and this model's header (state.slint).
                    mode_warning: AppState.preset_split_mode_warning;
                    mode_labels: AppState.split_mode_labels;
                    mode_values: AppState.split_mode_values;
                    mode_index <=> AppState.preset_split_mode_index;
                    effective_mode: AppState.preset_gpu_mode;
                    mode_picked(v) => { AppState.preset_split_mode_picked(v); }
                    split_mode_hint: Strings.t("split-mode-hint");
                    toggled(id) => { AppState.preset_gpu_toggle(id); }
                    reordered(id, delta) => { AppState.preset_gpu_move(id, delta); }
                    weight_edited(id, w) => { AppState.preset_gpu_weight(id, w); }
                    blocks_edited(id, n) => { AppState.preset_gpu_blocks(id, n); }
                    auto_split() => { AppState.preset_gpu_auto(); }
                    even_split() => { AppState.preset_gpu_even(); }
                }
            }

            SectionCard {
                heading: Strings.t("tensor-placement");
                Text {
                    text: Strings.t("tensor-placement-intro");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                TensorOverrideTable {
                    rows: AppState.preset_tensor_rows;
                    summary: AppState.preset_tensor_summary;
                    warning: AppState.preset_tensor_warning;
                    kind_labels: AppState.tensor_kind_labels;
                    kind_values: AppState.tensor_kind_values;
                    dev_labels: AppState.preset_tensor_dev_labels;
                    dev_values: AppState.preset_tensor_dev_values;
                    added() => { AppState.preset_tensor_add(); }
                    removed(i) => { AppState.preset_tensor_remove(i); }
                    kind_picked(i, kind) => { AppState.preset_tensor_kind(i, kind); }
                    device_picked(i, dev) => { AppState.preset_tensor_device(i, dev); }
                    pattern_edited(i, p) => { AppState.preset_tensor_pattern(i, p); }
                    layers_edited(i, l) => { AppState.preset_tensor_layers(i, l); }
                    coverage: AppState.preset_tensor_coverage;
                    can_pick: AppState.preset_tensor_can_pick;
                    pick(i) => { AppState.preset_tensor_pick(i); }
                }
            }

            SectionCard {
                heading: Strings.t("hardware-config");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("gpu-layers");
                    hint: Strings.t("gpu-layers-hint");
                    AutoSlider {
                        auto <=> AppState.form.n_gpu_layers_auto;
                        value <=> AppState.form.n_gpu_layers;
                        maximum: AppState.gpu_layers_max;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("moe-cpu-layers");
                    hint: Strings.t("moe-cpu-layers-hint");
                    // --n-cpu-moe only affects MoE models, so gate the whole row on it.
                    AutoSlider {
                        auto <=> AppState.form.n_cpu_moe_auto;
                        value <=> AppState.form.n_cpu_moe;
                        maximum: AppState.gpu_layers_max;  // = the model's layer count
                        usable: AppState.model_info_has_moe;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("moe-cache");
                    hint: Strings.t1("moe-cache-hint", AppState.moe_cache_floor_hint(AppState.form, AppState.model_info_serial) != "" ? AppState.moe_cache_floor_hint(AppState.form, AppState.model_info_serial) : ".");
                    // Gated on has_moe like the row above: on a dense model any
                    // positive value fails the load (and the prune drops it).
                    DefaultLineEdit {
                        enabled: AppState.model_info_has_moe;
                        input_type: InputType.number;
                        default <=> AppState.form.moe_cache_mib_default;
                        value <=> AppState.form.moe_cache_mib;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("dense-ffn-cpu-layers");
                    hint: Strings.t("dense-ffn-cpu-layers-hint");
                    // Not gated on has_moe like the row above: the dense FFN exists
                    // on every model (on a MoE one, only in its dense layers), and
                    // llama.cpp accepts the flag for both.
                    AutoSlider {
                        auto <=> AppState.form.n_cpu_ffn_auto;
                        value <=> AppState.form.n_cpu_ffn;
                        maximum: AppState.gpu_layers_max;  // = the model's layer count
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("op-offload");
                    hint: Strings.t("op-offload-hint");
                    // Not gated on has_moe: a dense model reaches the same state
                    // through 'Dense FFN CPU layers' or a Tensor placement rule.
                    SegmentedControl {
                        options: ["default", "on", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.op_offload == "" ? "default" : AppState.form.op_offload;
                        activated(value) => { AppState.form.op_offload = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("repack");
                    hint: Strings.t("repack-hint");
                    SegmentedControl {
                        options: ["default", "on", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.repack == "" ? "default" : AppState.form.repack;
                        activated(value) => { AppState.form.repack = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("no-host-buffer");
                    hint: Strings.t("no-host-buffer-hint");
                    SegmentedControl {
                        options: ["off", "on"];
                        labels: [Strings.t("off"), Strings.t("on")];
                        current: AppState.form.no_host ? "on" : "off";
                        activated(value) => { AppState.form.no_host = value == "on"; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("lazy-tensors");
                    hint: Strings.t("lazy-tensors-hint");
                    // Four entries, the first the "omit the flag" state: an enum
                    // string like reasoning-effort, mapped in form.rs.
                    SegmentedControl {
                        options: ["default", "on", "auto", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("auto"), Strings.t("off")];
                        current: AppState.form.lazy_mode == "" ? "default" : AppState.form.lazy_mode;
                        activated(value) => { AppState.form.lazy_mode = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("load-mode");
                    hint: Strings.t("load-mode-hint");
                    EnumComboBox {
                        options: Options.load_modes;
                        labels: Options.load_mode_labels;
                        value <=> AppState.form.load_mode;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("fit-to-vram");
                    hint: Strings.t("fit-to-vram-hint");
                    CheckBox {
                        enabled: AppState.fit_allowed;
                        text: AppState.fit_allowed ? Strings.t("fit-allowed") : Strings.t("fit-not-allowed");
                        checked <=> AppState.form.fit;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("fit-min-context");
                    hint: Strings.t("fit-min-context-hint");
                    DefaultLineEdit {
                        enabled: AppState.form.fit;
                        input_type: InputType.number;
                        default <=> AppState.form.fit_ctx_default;
                        value <=> AppState.form.fit_ctx;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("fit-free-vram");
                    hint: Strings.t("fit-free-vram-hint");
                    LineEdit {
                        enabled: AppState.form.fit;
                        text <=> AppState.form.fit_target;
                        placeholder-text: "e.g. 1024 or 2048,1024";
                    }
                }
                // The two draft-PLACEMENT knobs below need a separate draft FILE,
                // not merely a draft: llama.cpp reads --device-draft and
                // --n-gpu-layers-draft only inside `if (has_dft())`, which is
                // false without --model-draft. With embedded MTP heads it builds
                // the draft context against the target model itself, so the draft
                // runs wherever the MODEL does and both flags are ignored; a pin
                // set here would look effective (VRAM even shows up on that card,
                // from the vision encoder) while the GPU never drafts a token.
                // Hence draft_file_active, not draft_active. See state.slint.
                if AppState.embedded_mtp_note : Text {
                    text: Strings.t("embedded-mtp-note");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-device");
                    hint: Strings.t("draft-device-hint");
                    MappedComboBox {
                        // Needs a draft FILE; llama.cpp ignores it otherwise.
                        enabled: AppState.draft_file_active;
                        labels: AppState.preset_draft_dev_labels;
                        values: AppState.preset_draft_dev_values;
                        index <=> AppState.preset_draft_dev_index;
                        picked(v) => { AppState.form.device_draft = v; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-gpu-layers");
                    hint: Strings.t("draft-gpu-layers-hint");
                    // Real drafter (block_count > 0): the same auto + slider +
                    // readout row as the other layer knobs, one canonical
                    // implementation (AutoSlider) instead of an inline copy.
                    if AppState.model_info_draft_n_layer > 0 : AutoSlider {
                        auto <=> AppState.form.n_gpu_layers_draft_auto;
                        value <=> AppState.form.n_gpu_layers_draft;
                        maximum: AppState.draft_layers_max;
                        usable: AppState.draft_file_active;
                    }
                    // MTP/nextn head (0 layers) or no header: auto checkbox + a
                    // binary CPU/GPU choice. A SegmentedControl (not a Switch):
                    // its highlight is a pure read of the model, so it never goes
                    // stale after a click; a Switch's `checked` self-assignment
                    // would break its one-way binding (the v1.1.1 staleness
                    // class). on GPU = all draft layers, on CPU = 0.
                    if AppState.model_info_draft_n_layer == 0 : CheckBox {
                        text: Strings.t("default");
                        enabled: AppState.draft_file_active;
                        checked <=> AppState.form.n_gpu_layers_draft_auto;
                    }
                    if AppState.model_info_draft_n_layer == 0 : SegmentedControl {
                        horizontal-stretch: 1;
                        enabled: !AppState.form.n_gpu_layers_draft_auto && AppState.draft_file_active;
                        options: ["on GPU", "on CPU"];
                        labels: [Strings.t("on-gpu"), Strings.t("on-cpu")];
                        current: AppState.form.n_gpu_layers_draft >= 1 ? "on GPU" : "on CPU";
                        activated(v) => { AppState.form.n_gpu_layers_draft = v == "on GPU" ? Options.all_layers : 0; }
                    }
                }
            }

            SectionCard {
                heading: Strings.t("resource-context");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("context-size");
                    hint: Strings.t("context-size-hint");
                    DefaultLineEdit {
                        edit_label: "preset-ctx-size";
                        input_type: InputType.number;
                        default <=> AppState.form.ctx_size_default;
                        value <=> AppState.form.ctx_size;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("parallel-seqs");
                    hint: Strings.t("parallel-seqs-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.parallel_default;
                        value <=> AppState.form.parallel;
                    }
