            SectionCard {
                heading: Strings.t("speculative-decoding");
                // One group per speculator, each under its own sub-heading. The
                // draft group needs a draft (a picked file or embedded MTP heads:
                // draft_active); the ngram-* groups draft from the context and
                // are enabled while spec-type lists their type. Greyed out, not
                // hidden, so every speculator's knobs are in view; the save drops
                // the keys of the ngram types spec-type does not name
                // (presets::prune_unused_ngram_keys).
                Text {
                    text: Strings.t("draft-model-group");
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-n-max");
                    hint: Strings.t("draft-n-max-hint");
                    DefaultLineEdit {
                        // Active only when a draft is available (selected or embedded MTP).
                        enabled: AppState.draft_active;
                        input_type: InputType.number;
                        default <=> AppState.form.spec_draft_n_max_default;
                        value <=> AppState.form.spec_draft_n_max;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-p-min");
                    hint: Strings.t("draft-p-min-hint");
                    DefaultLineEdit {
                        enabled: AppState.draft_active;
                        input_type: InputType.decimal;
                        default <=> AppState.form.spec_draft_p_min_default;
                        value <=> AppState.form.spec_draft_p_min;
                        placeholder: "e.g. 0.5";
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-n-min");
                    hint: Strings.t("draft-n-min-hint");
                    DefaultLineEdit {
                        enabled: AppState.draft_active;
                        input_type: InputType.number;
                        default <=> AppState.form.spec_draft_n_min_default;
                        value <=> AppState.form.spec_draft_n_min;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-n-ubatch");
                    hint: Strings.t("draft-n-ubatch-hint");
                    DefaultLineEdit {
                        enabled: AppState.draft_active;
                        input_type: InputType.number;
                        default <=> AppState.form.spec_draft_n_ubatch_default;
                        value <=> AppState.form.spec_draft_n_ubatch;
                    }
                }
                Text {
                    text: Strings.t("draft-cache-note");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-k-cache-type");
                    hint: Strings.t("draft-k-cache-type-hint");
                    EnumComboBox {
                        // Active whenever a draft context exists: a picked draft
                        // file OR embedded MTP heads (draft_active), since these
                        // apply in both cases.
                        enabled: AppState.draft_active;
                        options: Options.cache_types;
                        labels: Options.cache_type_labels;
                        value <=> AppState.form.spec_draft_type_k;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-v-cache-type");
                    hint: Strings.t("draft-v-cache-type-hint");
                    EnumComboBox {
                        enabled: AppState.draft_active;
                        options: Options.cache_types;
                        labels: Options.cache_type_labels;
                        value <=> AppState.form.spec_draft_type_v;
                    }
                }
                Text {
                    text: "ngram-mod";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("match-length");
                    hint: Strings.t("match-length-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-mod");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_mod_n_match_default;
                        value <=> AppState.form.spec_ngram_mod_n_match;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("min-draft");
                    hint: Strings.t("min-draft-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-mod");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_mod_n_min_default;
                        value <=> AppState.form.spec_ngram_mod_n_min;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("max-draft");
                    hint: Strings.t("max-draft-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-mod");
                        input_type: InputType.number;
