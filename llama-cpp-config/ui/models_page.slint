            SectionCard {
                heading: Strings.t("embeddings");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("embedding-mode");
                    hint: Strings.t("embedding-mode-hint");
                    SegmentedControl {
                        options: ["off", "on"];
                        labels: [Strings.t("off"), Strings.t("on")];
                        current: AppState.form.embeddings ? "on" : "off";
                        activated(value) => { AppState.form.embeddings = value == "on"; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("pooling");
                    hint: Strings.t("pooling-hint");
                    // Six entries, the first the "omit the flag" state: an enum
                    // string like lazy-mode, mapped in form.rs.
                    SegmentedControl {
                        options: ["default", "none", "mean", "cls", "last", "rank"];
                        labels: [Strings.t("default"), Strings.t("none"), Strings.t("mean"), "cls", Strings.t("last"), Strings.t("rank")];
                        current: AppState.form.pooling == "" ? "default" : AppState.form.pooling;
                        activated(value) => { AppState.form.pooling = value; }
                    }
                }
            }

            SectionCard {
                heading: Strings.t("kv-cache");
                if AppState.preset_kv_cache_warning != "" : WrapText {
                    text: AppState.preset_kv_cache_warning;
                    font_size: 12px;
                    color: Tokens.err;
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("k-cache-type");
                    hint: Strings.t("k-cache-type-hint");
                    // "default" is the first entry of Options.cache_types and is
                    // NOT the f16 entry: it omits the flag (form.rs maps it to an
                    // empty string, which render_section drops) rather than pinning
                    // today's llama.cpp default as a literal value.
                    EnumComboBox {
                        options: Options.cache_types;
                        labels: Options.cache_type_labels;
                        value <=> AppState.form.cache_type_k;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("v-cache-type");
                    hint: Strings.t("v-cache-type-hint");
                    EnumComboBox {
                        options: Options.cache_types;
                        labels: Options.cache_type_labels;
                        value <=> AppState.form.cache_type_v;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("flash-attention");
                    hint: Strings.t("flash-attention-hint");
                    // TRI-state, not a checkbox: --flash-attn is [on|off|auto] and
                    // its default is auto, so a bool can only ever say two of the
                    // three things. Same shape (and same reason) as "Keep past
                    // thinking" below: a SegmentedControl over a form STRING,
                    // mapped to Option<bool> in form.rs.
                    SegmentedControl {
                        options: ["default", "on", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.flash_attn == "" ? "default" : AppState.form.flash_attn;
                        activated(value) => { AppState.form.flash_attn = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("cache-ram");
                    hint: Strings.t("cache-ram-hint");
                    // `decimal`, not `number`: this is the one integer field whose
                    // value may start with a `-` (the -1 sentinel), and `number`
                    // accepts digits only. Rust still parses it as an int.
                    DefaultLineEdit {
                        input_type: InputType.decimal;
                        default <=> AppState.form.cache_ram_default;
                        value <=> AppState.form.cache_ram;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("cache-reuse");
                    hint: Strings.t("cache-reuse-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.cache_reuse_default;
                        value <=> AppState.form.cache_reuse;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("context-checkpoints");
                    hint: Strings.t("context-checkpoints-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.ctx_checkpoints_default;
                        value <=> AppState.form.ctx_checkpoints;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("checkpoint-step");
                    hint: Strings.t("checkpoint-step-hint");
                    DefaultLineEdit {
                        input_type: InputType.number;
                        default <=> AppState.form.checkpoint_min_step_default;
                        value <=> AppState.form.checkpoint_min_step;
                    }
                }
            }

            SectionCard {
                heading: Strings.t("chat-reasoning");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("chat-template");
                    hint: Strings.t("use-chat-template-hint");
                    CheckBox {
                        text: Strings.t("use-chat-template");
                        checked <=> AppState.form.jinja;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("prefill-assistant");
                    hint: Strings.t("prefill-assistant-hint");
                    CheckBox {
                        text: Strings.t("prefill-assistant-toggle");
                        checked <=> AppState.form.prefill_assistant;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("reasoning");
                    hint: Strings.t("reasoning-hint");
                    // A RadioGroup imperatively sets each button's `checked` on
                    // selection, which breaks the binding and leaves the pick stale
                    // on preset switch. SegmentedControl derives its highlight purely
                    // from `current`, so it stays in sync.
                    SegmentedControl {
                        options: ["auto", "on", "off"];
                        labels: [Strings.t("auto"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.reasoning == "" ? "auto" : AppState.form.reasoning;
                        activated(value) => { AppState.form.reasoning = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("reason-format");
                    hint: Strings.t("reason-format-hint");
                    SegmentedControl {
                        options: ["auto", "none", "deepseek"];
                        labels: [Strings.t("auto"), Strings.t("none"), "deepseek"];
                        current: AppState.form.reasoning_format == "" ? "auto" : AppState.form.reasoning_format;
                        activated(value) => { AppState.form.reasoning_format = value; }
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("reasoning-effort");
                    hint: Strings.t("reasoning-effort-hint");
                    // Seven entries is past what a SegmentedControl can carry, and
                    // the first one is the "omit the flag" state, so this follows
                    // the cache-type combos rather than the switches above.
                    EnumComboBox {
                        options: ["default", "minimal", "low", "medium", "high", "xhigh", "max"];
                        labels: [Strings.t("default"), Strings.t("minimal"), Strings.t("low"), Strings.t("medium"), Strings.t("high"), Strings.t("extra-high"), Strings.t("maximum")];
                        value <=> AppState.form.reasoning_effort;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("keep-past-thinking");
                    hint: Strings.t("keep-past-thinking-hint");
                    SegmentedControl {
                        options: ["default", "on", "off"];
                        labels: [Strings.t("default"), Strings.t("on"), Strings.t("off")];
                        current: AppState.form.reasoning_preserve == "" ? "default" : AppState.form.reasoning_preserve;
                        activated(value) => { AppState.form.reasoning_preserve = value; }
                    }
                }
                Text {
                    text: Strings.t("output-budget-note");
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("thinking-budget");
                    hint: Strings.t("thinking-budget-hint");
                    DefaultLineEdit {
                        edit_label: "preset-reasoning-budget";
                        // decimal, not number: -1 needs a typeable leading sign.
                        input_type: InputType.decimal;
                        default <=> AppState.form.reasoning_budget_default;
                        value <=> AppState.form.reasoning_budget;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("budget-message");
                    hint: Strings.t("budget-message-hint");
                    LineEdit {
                        text <=> AppState.form.reasoning_budget_message;
                        placeholder-text: Strings.t("budget-message-placeholder");
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("max-output");
                    hint: Strings.t("max-output-hint");
                    DefaultLineEdit {
                        input_type: InputType.decimal;
                        default <=> AppState.form.n_predict_default;
                        value <=> AppState.form.n_predict;
                    }
                }
            }

            SectionCard {
                heading: Strings.t("sampling-overrides");
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("temperature");
                    hint: Strings.t("sampling-temperature-hint");
                    DefaultLineEdit {
                        edit_label: "preset-temp";
                        default <=> AppState.form.temp_default;
                        value <=> AppState.form.temp;
                        placeholder: "e.g. 0.7";
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: "Top-K";
                    hint: Strings.t("top-k-hint");
                    // Integer-valued, so `number` (digits only) and not the
                    // `decimal` the float knobs below take; a decimal editor
