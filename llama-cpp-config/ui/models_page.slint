                Text {
                    text: "ngram-map-k";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("lookup-n-gram");
                    hint: Strings.t("ngram-map-lookup-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-map-k");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_map_k_size_n_default;
                        value <=> AppState.form.spec_ngram_map_k_size_n;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-m-gram");
                    hint: Strings.t("ngram-map-draft-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-map-k");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_map_k_size_m_default;
                        value <=> AppState.form.spec_ngram_map_k_size_m;
                    }
                }
                Text {
                    text: "ngram-map-k4v";
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("lookup-n-gram");
                    hint: Strings.t("ngram-map-values-lookup-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-map-k4v");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_map_k4v_size_n_default;
                        value <=> AppState.form.spec_ngram_map_k4v_size_n;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("draft-m-gram");
                    hint: Strings.t("ngram-map-values-draft-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-map-k4v");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_map_k4v_size_m_default;
                        value <=> AppState.form.spec_ngram_map_k4v_size_m;
                    }
                }
                LabeledField {
                    label_width <=> LabelColumn.models;
                    label: Strings.t("min-hits");
                    hint: Strings.t("min-hits-hint");
                    DefaultLineEdit {
                        enabled: AppState.spec_type_has(AppState.form.spec_type, "ngram-map-k4v");
                        input_type: InputType.number;
                        default <=> AppState.form.spec_ngram_map_k4v_min_hits_default;
                        value <=> AppState.form.spec_ngram_map_k4v_min_hits;
                    }
                }
            }

            FormActions {
                save_text: Strings.t("save-preset");
                // Shared with the Ctrl+S shortcut; the gate lives in state.slint.
                save_enabled: AppState.can_save_preset;
                revert_enabled: AppState.selected_preset_index >= 0 && AppState.preset_dirty;
                save => { AppState.save_preset(); }
                revert => { AppState.revert_preset(); }
            }
        }
    }
}
