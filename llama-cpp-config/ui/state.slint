// Shared application state for the configurator.
//
// Every property and callback that Rust drives (plus anything more than one
// component reads) lives here, in one exported global, so each datum is
// declared ONCE instead of three times (AppWindow field → forwarding binding →
// page field). The tab pages are conditionally instantiated, so Rust cannot
// reach a property declared on a page: a Rust-driven datum belongs here even
// when a single page reads it. Rust drives the global via
// `app.global::<AppState>()`; the pages read/write `AppState.<name>` directly.
//
// The tray (`AppTray` in app.slint) is a separate root and does NOT use this
// global; it keeps its own pushed-in state.

import { PresetSummary, PresetForm, ServerForm, GpuRow, TensorOverrideRow, TensorPickRow, DeleteFileRow, BenchPresetRow, BenchResultRow, BindRow } from "types.slint";
import { Options } from "components.slint";

export global AppState {
    // Crate version (CARGO_PKG_VERSION), pushed in from Rust at startup so the
    // title bar always reflects the built version.
    in-out property <string> app_version;

    // ── Navigation ───────────────────────────────────────────────────
    // 0 = Server, 1 = Models, 2 = Benchmark, 3 = Integrations, 4 = Settings.
    in-out property <int> current_tab: 0;

    // ── Live status ──────────────────────────────────────────────────
    in-out property <bool> server_running: false;
    // Transitional flag: Stop has been triggered but the process is still
    // running (a forced kill lingers a moment while the GPU context unwinds).
    // Held true by Rust until `tasklist` confirms the process is gone.
    in-out property <bool> server_stopping: false;
    // Transitional flag: Start has been triggered but the launch (which opens
    // with a tasklist probe) hasn't completed, held true by Rust while the
    // start runs off the UI thread, mirroring server_stopping.
    in-out property <bool> server_starting: false;
    in-out property <bool> server_status_is_error: false;
    in-out property <string> server_version: "";
    in-out property <string> server_command_line: "";
    // Client URL of the SAVED server.ini, derived by Rust alongside the
    // command line (gui::refresh_server_snapshot): saved port + client_host,
    // which maps a 0.0.0.0 bind to localhost (a listen address is not a
    // connectable one).
    in-out property <string> chat_url: "";
    // Client URL snapshotted when the GUI launched llama-server (empty while
    // stopped, or when the server was started outside the GUI). The RUNNING
    // process listens on what it was launched with (saving a new port only
    // changes the file), so the Open-chat button prefers this over chat_url.
    in-out property <string> launched_url: "";
    out property <string> open_chat_url: !server_form.base_url_default ? chat_url
        : (server_running && launched_url != "" ? launched_url : chat_url);
    // Whether the web UI is served (server.ini Webui), the same two sources as
    // the URL above: `chat_ui_saved` is the SAVED file (pushed with chat_url by
    // gui::refresh_server_snapshot), `launched_ui` the config the GUI launched
    // with (pushed with launched_url, meaningful only while that is non-empty).
    // The running process keeps what it was launched with, so a save turning
    // the UI off (or on) while it runs changes nothing until a restart.
    in-out property <bool> chat_ui_saved: true;
    in-out property <bool> launched_ui: true;
    out property <bool> chat_ui_enabled: server_running && launched_url != "" ? launched_ui : chat_ui_saved;
    // The Server rail's button and the tray's item (pushed from Rust, AppTray
    // has no AppState) are enabled on this: a server without its UI answers /
    // with a 404.
    out property <bool> can_open_chat: server_running && !server_stopping && chat_ui_enabled;
    // Open the chat UI in the browser: the Server rail's "Open chat UI" button
    // and the tray's item (gui/tray.rs) both come through here, so they open
    // the same URL. Guarded as well: the tray's copy of the state can lag a
    // status tick behind.
    public function open_chat() {
        if (chat_ui_enabled) {
            Platform.open-url(open_chat_url);
        }
    }

    // ── Server tab state ─────────────────────────────────────────────
    // All editable server.ini fields live in one struct (ServerForm), like the
    // preset side's `form`. Rust drives it via config_to_form / form_to_config
    // (src/server_form.rs); `server_form_base` is the loaded/saved baseline and
    // dirty-tracking is a single struct compare. The bind/device dropdowns below
    // are option lists (not form values), so they stay separate.
    // No Slint-side initializer: Rust seeds both structs from disk before the
    // event loop starts (gui::run() → load_server_into_ui), and the display
    // defaults have ONE owner: server_form::config_to_form.
    in-out property <ServerForm> server_form;
    in-out property <ServerForm> server_form_base;
    out property <bool> server_dirty: server_form != server_form_base;
    // Save gating shared by the Server tab's Save button and the Ctrl+S
    // shortcut (app.slint): single source so the two can't drift.
    out property <bool> can_save_server: server_dirty;

    // Logical-processor count (std::thread::available_parallelism), pushed from
    // Rust at startup, the upper bound for the CPU-threads / batch-threads
    // sliders. A generous fallback keeps the sliders usable if the probe fails.
    in-out property <int> cpu_threads_max: 32;

    // "Bind to" (hostname) checkboxes, derived from the local interfaces and the
    // saved comma-separated list (src/net_ifaces.rs). A click calls bind_toggle,
    // and Rust rewrites server_form.hostname and rebuilds these rows.
    in-out property <[BindRow]> bind_rows;
    callback bind_toggle(string);

    // The split-mode combo model of the PRESET table (gpu_split::MODE_LABELS /
    // MODE_VALUES, pushed once per row refresh); the index is two-way: Rust
    // recomputes it from the form value on every refresh, a pick reports back
    // through preset_split_mode_picked.
    in-out property <[string]> split_mode_labels;
    in-out property <[string]> split_mode_values;

    // Non-empty when an AMD GPU was detected but no ROCm device beside it, i.e.
    // llama.cpp is driving that card through Vulkan instead of HIP. It is the
    // one backend that goes missing SILENTLY (ggml drops a backend whose imports
    // don't resolve without a word), so nothing else in the UI would say it.
    // Computed in Rust from the probe crossed with the installed ROCm dist
    // (devices::rocm_health) and refreshed with the device dropdowns.
    in-out property <string> rocm_warning: "";

    // ── Models tab state ─────────────────────────────────────────────
    in-out property <[PresetSummary]> presets;
    in-out property <int> selected_preset_index: -1;
    in-out property <PresetForm> form;
    // Baseline snapshot of the loaded preset (set by Rust whenever the form is
    // (re)loaded or saved). Struct inequality drives Save/Revert enabled.
    in-out property <PresetForm> form_base;
    // The Fit checkbox is live only with Context and GPU layers both at
    // default, the two things the fit sizes (form::fit_allowed, the same rule
    // on save, which writes `fit = off` otherwise).
    out property <bool> fit_allowed: form.ctx_size_default && form.n_gpu_layers_auto;
    out property <bool> preset_dirty: form != form_base;
    // Save gating shared by the Models tab's Save button and the Ctrl+S
    // shortcut (app.slint): single source so the two can't drift.
    out property <bool> can_save_preset: selected_preset_index >= 0 && form.id != "" && preset_dirty;
    in-out property <string> presets_path: "";
    in-out property <string> presets_filter: "";

    // Per-preset GPU distribution table, over `form.device` / `form.tensor_split`.
    // The distribution is per preset only: server.ini has none, since the
    // router's own CLI args would override every preset's.
    in-out property <[GpuRow]> preset_gpu_rows;
    in-out property <int> preset_split_mode_index: 0;
    in-out property <string> preset_gpu_mode: "layer";
    in-out property <int> preset_gpu_selected: 0;
    in-out property <int> preset_gpu_total: 0;
    // Positions this model's split is cut over: its block count plus one for the
    // output layer, minus whatever stays on the CPU (gpu_split::Layout). It is
    // what lets the table edit BLOCKS instead of ratios; 0 = no model read, so the
    // table falls back to raw weights.
    in-out property <int> preset_split_positions: 0;
    // The preconditions of split mode `tensor` this form can see, each a LOAD
    // failure llama.cpp reports only in its log: the arch must be one upstream's
    // tensor parallelism implements (`model_info_tensor_arch_warning`, read from
    // the GGUF by Rust), flash attention must not be `off`
    // (`llama_init_from_model` returns null; `auto` is promoted to on), and, the
    // one with no error message at all, with no device pinned llama.cpp pools
    // EVERY detected device into the meta device, the duplicate Vulkan views of a
    // card and the iGPU included (`llama_prepare_model_devices` dedups by device
    // id only in the other modes). Last, a split mixing CUDA and ROCm devices,
    // which aborts at load under every AllReduce but `none` (server_cfg.rs
    // `cuda_allreduce`). First wins: each one alone spoils the launch.
    out property <string> preset_split_mode_warning: preset_gpu_mode != "tensor" ? ""
        : model_info_tensor_arch_warning != "" ? model_info_tensor_arch_warning
        : form.flash_attn == "off"
        ? "Split mode tensor requires flash attention: with Flash attention off, llama.cpp refuses to create the context and the model does not load. Set it to on or default."
        : form.device == ""
        ? "Split mode tensor with no GPU checked: llama.cpp then pools EVERY detected device into the split, duplicate Vulkan views of the same card and the iGPU included. Check the GPUs to run on."
        : (preset_mixes_cuda_rocm && server_form.cuda_allreduce != "none")
        ? "Split mode tensor across a CUDA and a ROCm device: the model aborts while loading unless Server tab > SDK Tuning > Tensor-split AllReduce is set to none. Even then, expect about half the prefill speed of the layer split."
        : "";
    // Whether this preset's device list names both a CUDA and a ROCm device:
    // gpu_split::mixes_cuda_and_rocm, pushed by refresh_gpu_rows. Slint has no
    // substring test to derive it here.
    in-out property <bool> preset_mixes_cuda_rocm;

    // Per-preset tensor-placement table (TensorOverrideTable), over the single
    // `form.override_tensor` string. Rows and BOTH dropdown models are built in
    // Rust (src/tensor_override.rs) and are read-only to Slint; every edit is a
    // whole-string rewrite. Rules are addressed by ROW INDEX, not by an id: the
    // same pattern may legitimately appear twice (two devices, two halves of a
    // model), unlike the GPU table's unique device ids.
    in-out property <[TensorOverrideRow]> preset_tensor_rows;
    in-out property <string> preset_tensor_summary;
    // Non-empty when the value is one llama.cpp would refuse (a rule with no
    // device). Only a hand-edited presets.ini reaches it (the table sanitizes
    // everything it writes), but that value would fail the model's LOAD, so it
    // is worth saying out loud rather than at the next launch.
    in-out property <string> preset_tensor_warning;
    // Per rule, what it places on the selected model ("12 tensors, 1.21 GiB"),
    // counting first-match-wins; empty strings when the model's tensors are
    // unknown. Its own model, not a row field, so a regex keystroke updates it
    // without recreating the field being typed into.
    in-out property <[string]> preset_tensor_coverage;
    // The model's tensor list is known, so the rows' "Choose…" can open.
    in-out property <bool> preset_tensor_can_pick;

    // The tensor picker modal (app.slint), over one rule: built in Rust
    // (src/tensor_picker.rs) and read-only here.
    in-out property <bool> tensor_picker_open;
    in-out property <string> tensor_picker_title;
    in-out property <[TensorPickRow]> tensor_picker_rows;
    in-out property <string> tensor_picker_summary;
    // The regex Apply would write.
    in-out property <string> tensor_picker_pattern;
    in-out property <bool> tensor_picker_can_apply;
    // Non-empty when a KV cache the preset builds (the model's, or the draft's)
    // has no FlashAttention kernel on a backend it runs on, has none compiled
    // natively for its K-V pair, or cannot load at all (quantized V with flash
    // attention off). Computed in Rust (src/kv_cache.rs) because it needs the
    // device list parsed and the probe; recomputed on `kv_cache_inputs_changed`
    // and whenever the GPU rows are rebuilt.
    in-out property <string> preset_kv_cache_warning;
    // The option models behind every row's two dropdowns. The KIND list is shared
    // by both tables (canned patterns; last entry = "Custom regex…", the only one
    // that reveals the pattern's text field). The DEVICE list is NOT: it is the
    // probed devices INCLUDING the CPU (a legal -ot target, unlike in the GPU
    // table above) PLUS a `(custom)` entry per device id the probe doesn't know,
    // which is a property of that table's own rules, so each scope gets its own
    // model, or the two would alias each other's row indices (see gui.rs).
    in-out property <[string]> tensor_kind_labels;
    in-out property <[string]> tensor_kind_values;
    in-out property <[string]> preset_tensor_dev_labels;
    in-out property <[string]> preset_tensor_dev_values;

    // Draft-model GPU-device dropdown triple, fed from the same
    // `devices::probed()` cache as the tables above. Still a dropdown, not a
    // table: --device-draft takes ONE device (a draft is never split).
    // Vision-encoder (mmproj) device dropdown triple, over form.mmproj_device.
    // Its own list because the encoder is placed separately: unset, llama.cpp
    // follows the first entry of --device (v0.4.1) or grabs the first GPU
    // backend it finds; --mmproj-device overrides both.
    in-out property <[string]> preset_mmproj_dev_labels;
    in-out property <[string]> preset_mmproj_dev_values;
    in-out property <int> preset_mmproj_dev_index: 0;
    in-out property <[string]> preset_draft_dev_labels;
    in-out property <[string]> preset_draft_dev_values;
    in-out property <int> preset_draft_dev_index: 0;

    // File-field dropdowns for model and mmproj
    in-out property <[string]> model_labels;
    in-out property <[string]> model_values;
    in-out property <int> model_index: -1;
    in-out property <[string]> mmproj_labels;
    in-out property <[string]> mmproj_values;
    in-out property <int> mmproj_index: -1;
    // Unified draft-model picker (MTP heads from mtps\ + DFlash drafters from
    // dflashs\). Only labels + index live here; the per-row (--model-draft,
    // --spec-type) pairs are Rust-only (`State.draft_rows` in gui.rs), read by
    // the draft_picked handler.
    in-out property <[string]> draft_labels;
    in-out property <int> draft_index: -1;

    // Read-only "Model info" box, filled by Rust (model_changed) from the
    // selected model's GGUF header. `model_info_ready` gates between the info
    // rows and a muted placeholder/error note (`model_info_note`).
    in-out property <bool> model_info_ready: false;
    in-out property <string> model_info_note;
    in-out property <string> model_info_kind;
    // MoE-only: how many layers hold experts + the --n-cpu-moe range. Hidden for
    // dense models (`model_info_has_moe`).
    in-out property <bool> model_info_has_moe: false;
    in-out property <string> model_info_moe;
    // The tail of the MoE cache hint: this preset's --moe-cache-mib floors on the
    // selected model (moe_cache::Floor::hint), "" when there is none to quote.
    // A pure callback over the form, so the text follows every placement edit
    // (n-gpu-layers, n-cpu-moe, override-tensor, device, tensor-split) without a
    // refresh hook per field. The Models tab's Save refuses below the first number.
    // The int is `model_info_serial`: the model's tensors live in Rust, where
    // Slint's dependency tracking cannot see them, so the binding passes the
    // serial to be re-evaluated when they change.
    pure callback moe_cache_floor_hint(PresetForm, int) -> string;
    // `form.spec_type` is a comma-separated --spec-type list: at most one
    // draft-* entry (the "Drafter" combo) plus any ngram-* entries (one
    // checkbox each). These read and rewrite ONE entry of it, keeping the
    // rest; the list itself stays the only state (presets.rs `spec_type_*`).
    pure callback spec_type_drafter(string) -> string;
    pure callback spec_type_has(string, string) -> bool;
    pure callback spec_type_with_drafter(string, string) -> string;
    pure callback spec_type_with_ngram(string, string, bool) -> string;
    // Bumped by every `update_model_info`, i.e. whenever the Rust-side model
    // facts (its tensor list above all) may have changed.
    in-out property <int> model_info_serial: 0;
    in-out property <string> model_info_arch_quant;
    // token_embd's OWN quant + size, not implied by the file's name or by
    // `model_info_arch_quant`: Unsloth's Q6_K_XL keeps the embedding table at
    // Q8_0 while its Q4_K_XL/Q5_K_XL drop it to a K-quant. Whether it can be
    // pinned to a GPU is a per-TYPE question (the backend needs a get_rows
    // kernel for it: `gguf::gpu_has_get_rows`, which covers the K-quants since
    // llama.cpp b10089 and still excludes Q8_1/Q8_K/TQ*/NVFP4).
    // `model_info_embd_warning` is non-empty ONLY when the type is known AND
    // unpinnable; it is what the Tensor-placement table shows when a rule
    // pins the table anyway. Empty for an unreadable GGUF, so a failed metadata
    // read never masquerades as a problem.
    in-out property <string> model_info_embd;
    in-out property <string> model_info_embd_warning;
    // Non-empty when llama.cpp's tensor parallelism does not implement this
    // model's architecture (`gguf::arch_supports_sm_tensor`, a mirror of
    // upstream's deny-list): under split mode `tensor` the load throws, so
    // `preset_split_mode_warning` shows it the moment that mode is effective.
    // Empty for an unreadable GGUF (same rule as the embd warning).
    in-out property <string> model_info_tensor_arch_warning;
    in-out property <string> model_info_layers_ctx;
    in-out property <string> model_info_attn;
    // gguf.rs `memory_line`: attention / recurrent / hybrid, per architecture.
    in-out property <string> model_info_memory;
    in-out property <string> model_info_draft;
    // Chat template detection (read from GGUF `tokenizer.chat_template`).
    // `model_info_chat_template` is the short status text ("Jinja (embedded)" /
    // "embedded (non-Jinja)" / "none"), rendered in a LabeledField (not an
    // InfoRow) so a Preview button can sit beside it;
    // `chat_template_preview` holds the raw template text for the Preview
    // modal, and is empty when no template is embedded, which also gates the
    // Preview button (no point previewing an absent template).
    in-out property <string> model_info_chat_template: "none";
    in-out property <string> chat_template_preview: "";
    // Reasoning support, read off that same template's SOURCE (no Jinja engine
    // here; see gguf.rs `Thinking`). `model_info_thinking` says whether the model
    // thinks and whether --reasoning can switch it; `model_info_past_thinking`
    // says whether --reasoning-preserve is a LEVER at all, i.e. whether the
    // template names one of the three variables that flag sets. A `no` there is
    // the useful half: it means the flag changes nothing on this model, which the
    // llama-server log cannot tell you (its probe reports "supported" for a
    // template that preserves unconditionally too).
    in-out property <string> model_info_thinking: "unknown";
    in-out property <string> model_info_past_thinking: "unknown";
    // Optional rows, shown only when a mmproj / draft file is selected.
    in-out property <bool> model_info_has_mmproj: false;
    in-out property <string> model_info_mmproj;
    in-out property <bool> model_info_has_draft_file: false;
    in-out property <string> model_info_draft_file;
    // True when the main model embeds MTP/nextn heads (`<arch>.nextn_predict_layers` > 0):
    // speculative decoding is possible even before an external draft file is picked.
    in-out property <bool> model_info_embeds_mtp: false;
    // Layer counts (block_count) of the selected model and draft, driving the
    // GPU-layers / MoE-CPU-layers / draft-GPU-layers slider maxima. For the
    // MODEL sliders 0 = unknown (metadata unavailable) and gpu_layers_max
    // falls back to a 0..Options.all_layers range; the draft slider needs no
    // fallback: models_page only shows it when draft_n_layer > 0 (a 0-layer
    // MTP head gets the CPU/GPU switch instead).
    in-out property <int> model_info_n_layer: 0;
    in-out property <int> model_info_draft_n_layer: 0;
    out property <int> gpu_layers_max: model_info_n_layer > 0 ? model_info_n_layer : Options.all_layers;
    out property <int> draft_layers_max: model_info_draft_n_layer;
    // Speculative-decoding controls are active when a draft model is selected OR
    // the main model embeds MTP heads; otherwise there is nothing to draft with.
    out property <bool> draft_active: form.model_draft != "" || model_info_embeds_mtp;
    // …but the draft PLACEMENT controls (--device-draft, --n-gpu-layers-draft)
    // need a separate draft FILE, not just a draft. llama.cpp applies both only
    // inside `if (has_dft())`, i.e. when a --model-draft path was given; with
    // embedded MTP heads it builds the draft context against the target model
    // itself ("MTP draft context lives on the target model", server-context.cpp),
    // so the draft runs on the MODEL's device and both flags are silently ignored.
    // Enabling them anyway is how a draft ends up "pinned" to a GPU that then sits
    // idle. `embedded_mtp_note` explains that where the controls are.
    out property <bool> draft_file_active: form.model_draft != "";
    out property <bool> embedded_mtp_note: draft_active && !draft_file_active;

    // ── New-preset dialog state ─────────────────────────────────────
    in-out property <bool> show_new_kind_picker: false;
    in-out property <string> new_dialog_source_id: "";
    in-out property <[string]> dialog_model_labels;
    in-out property <int> dialog_model_index: -1;
    in-out property <string> dialog_filter: "";

    // ── Hugging Face download dialog state (src/gui/hf_dialog.rs) ───
    // The New preset dialog's second source: search GGUF repositories by name
    // (or type one), list a repo's GGUF quantizations, pick one and its
    // sidecars, and start its download, which closes the dialog: the transfer
    // and the preset's creation run in the background (src/gui/downloads.rs,
    // the Downloads window). Rust drives the phase (`hf_dialog::Phase`, the
    // int below) and every list and readout; the widgets bind two-way only to
    // what the user edits (`hf_input`, `hf_token`, `hf_take_mmproj`) plus the
    // drafter pill, a SegmentedControl.
    in-out property <bool> show_hf_dialog: false;
    // 0 idle (typing), 1 searching, 2 searched (results shown), 3 listing,
    // 4 listed.
    in-out property <int> hf_phase: 0;
    // A search or a listing is in flight (one request at a time).
    out property <bool> hf_busy: hf_phase == 1 || hf_phase == 3;
    // The results list shows in phases 0-2, the quantization list from 3 on.
    out property <bool> hf_show_results: hf_phase <= 2;
    // The one field: a free-text search (`qwen3 8b`) or a repository spec
    // (`org/repo`, `org/repo:QUANT`, its URL), told apart by `hf_input_is_query`.
    in-out property <string> hf_input: "";
    // Typed by the user only: never prefilled, never saved, never logged. An
    // EMPTY field means "the token the environment has" (`hf::token_from_env`,
    // read by Rust at request time), which `hf_env_token` advertises in the
    // field's placeholder, so the token itself never enters the UI.
    in-out property <string> hf_token: "";
    in-out property <bool> hf_env_token: false;
    // The search results: a title line, then one row per repository
    // (`org/repo · downloads · gated`), its second line the quantizations and
    // sidecars its file names show. `hf_result_index` marks the row picked.
    // `hf_has_results` (kept while a picked row is listed) offers "Back to
    // results".
    in-out property <string> hf_results_title: "";
    in-out property <[string]> hf_result_labels;
    in-out property <[string]> hf_result_details;
    in-out property <int> hf_result_index: -1;
    in-out property <bool> hf_has_results: false;
    // "repo @ commit" over the candidate list, once listed.
    in-out property <string> hf_listing_title: "";
    // What the placement estimates are measured against (GPUs, RAM, the
    // margins), under the title; empty without a GPU.
    in-out property <string> hf_estimate_basis: "";
    in-out property <[string]> hf_candidate_labels;
    // Per candidate, its second line: the placement estimate on this machine
    // (filled in as each GGUF header is read), led by "recommended, <why>"
    // on the recommended one.
    in-out property <[string]> hf_candidate_details;
    in-out property <int> hf_candidate_index: -1;
    // The chosen candidate's sidecars: the mmproj tick shows only when it has
    // one, the drafter pills only when it has a drafter ("none" + each kind).
    in-out property <bool> hf_mmproj_available: false;
    in-out property <bool> hf_take_mmproj: true;
    in-out property <[string]> hf_drafter_options;
    in-out property <string> hf_drafter: "none";
    // What the pick would fetch, and where to (one line).
    in-out property <string> hf_selection_summary: "";
    // A partial download of the listed repo is waiting (its staging tree):
    // the download button reads "Resume download".
    in-out property <bool> hf_resume: false;
    // The in-dialog error (an `HfError`, or a download refused because the
    // same repository is already downloading), and a muted note.
    in-out property <string> hf_error: "";
    in-out property <string> hf_note: "";

    // ── Background downloads (src/gui/downloads.rs) ─────────────────
    // The footer's indicator (and the modal's Downloads button): "" while the
    // Downloads window has no row, else how many run or how they ended. A
    // click fires `open_downloads`.
    in-out property <string> downloads_summary: "";

    // ── Rename-preset dialog state ──────────────────────────────────
    in-out property <bool> show_rename_dialog: false;
    in-out property <string> rename_old_id: "";
    in-out property <string> rename_new_id: "";

    // ── Discard-confirm dialog state ─────────────────────────────────
    // Shown by Rust (gui::confirm_discard_then) when a navigation action
    // (preset switch, Refresh/reload_all, New…/Clone…/Rename…) would replace
    // a dirty form. The pending action is stashed Rust-side (gui::State) and
    // runs only on confirm; cancel drops it and keeps the edits.
    in-out property <bool> show_discard_dialog: false;

    // ── Delete-confirm dialog state ──────────────────────────────────
    // Rust-driven (gui/models_tab.rs): the Models page's Delete button fires
    // `request_delete`, which seeds the target, lists the model files the
    // preset links (src/linked_files.rs: the model with all its shards, the
    // mmproj, the drafter; only those on disk) and shows this. Every file
    // starts UNticked (keep is the default); one another preset references,
    // in either INI file, is shown in use and cannot be ticked. The modal's
    // Delete button fires the real delete_preset, which removes the section,
    // then the ticked files and the per-repository folders they leave empty.
    // The ticks live Rust-side; the rows are a read-only projection rebuilt on
    // every `delete_file_toggle`.
    in-out property <bool> show_delete_dialog: false;
    in-out property <string> delete_target_id: "";
    // The file the section is removed from: presets.ini or presets.ini.disabled.
    in-out property <string> delete_target_file: "presets.ini";
    in-out property <[DeleteFileRow]> delete_file_rows;
    // How many rows are ticked (the Delete button's label follows it), and one
    // line naming what a confirm removes from disk.
    in-out property <int> delete_files_ticked: 0;
    in-out property <string> delete_files_summary: "";

    // ── Chat-template preview dialog state ──────────────────────────
    // Purely Slint-side: the Models-page "Chat template" row's Preview button
    // flips this. The raw template text is already in `chat_template_preview`
    // (pushed by Rust on every model change), so opening needs no callback.
    in-out property <bool> show_chat_template_dialog: false;

    // True while any modal dialog is open. The app-wide keyboard shortcuts
    // (app.slint) gate on this so Ctrl+S / Ctrl+N / tab switches can't act on
    // the page hidden behind the backdrop.
    out property <bool> modal_open: show_new_kind_picker || show_rename_dialog
        || show_discard_dialog || show_delete_dialog || show_chat_template_dialog
        || show_hf_dialog;

    // ── Benchmark tab state ─────────────────────────────────────────
    // Two engines behind one tab, and the mode decides which half of the
    // workload card is live, what the preview shows, and which llama-server
    // state the run demands (live needs it UP, synthetic needs it DOWN).
    // "live" = real requests to the running server, with a prompt and a
    // temperature override; "synthetic" = llama-bench over token COUNTS, which
    // takes no prompt and never samples. See src/bench.rs.
    in-out property <string> bench_mode: "live";
    out property <bool> bench_is_live: bench_mode == "live";
    // The selectable presets, built in Rust: the checkbox reports through
    // `bench_toggle_preset` and the whole model is rebuilt, so the row bindings
    // stay one-way like the GPU table's.
    in-out property <[BenchPresetRow]> bench_presets;
    in-out property <int> bench_selected_count: 0;
    // The first selected preset, i.e. the denominator of the ratio column.
    in-out property <string> bench_baseline: "";

    // Workload. Both halves are kept across a mode switch (the card shows the
    // one the mode reads), and every field is a plain string re-parsed in Rust,
    // for the same reason the two forms' numerics are: a SpinBox edits itself on
    // a stray scroll.
    // The live prompt is a FILE, never a text box: this is its path. The GUI
    // and the CLI (`--prompt-file`, and the same default with no flag) read the
    // same bytes, the file is read fresh at Run so an edit made outside is
    // picked up, and a prompt of any size is editable in a real editor. See the
    // src/bench.rs header for why the framework's own prompt is a SEED for this
    // file rather than something the installer writes.
    in-out property <string> bench_prompt_file;
    // Read-only readout of the file as it stands ("230 chars, 230 bytes,
    // sha256 8f3c…"), or why it cannot be read. Pushed from Rust, which re-reads
    // the file when it changes on disk.
    in-out property <string> bench_prompt_info: "";
    // "default" here means "leave the preset's own --temp alone", which is a
    // third instruction, not a missing one. Unchecked with a 0 is the default:
    // greedy sampling is what makes two runs of one prompt comparable.
    in-out property <bool> bench_temp_default: false;
    in-out property <string> bench_temp: "0";
    in-out property <string> bench_max_tokens;
    // Live only: "single", or one request per slot of the preset at once
    // ("prefill", "decode", "prefill+decode"): bench::Concurrency.
    in-out property <string> bench_concurrency: "single";
    in-out property <string> bench_reps;
    in-out property <string> bench_prompt_lens;
    in-out property <string> bench_depths;
    in-out property <string> bench_n_gen;

    // Read-only preview of what Run will actually do: the llama-bench command
    // line per preset (synthetic), or the HTTP request (live). The twin of the
    // Server tab's Command Line card, and pushed from Rust for the same reason:
    // it must be built by the code that builds the real thing.
    in-out property <string> bench_preview: "";
    // What this mode cannot measure, spelled out where the run is started
    // rather than only in the saved report.
    in-out property <string> bench_caveats: "";

    in-out property <bool> bench_running: false;
    in-out property <string> bench_progress: "";
    in-out property <[BenchResultRow]> bench_rows;
    // Which run the table is showing: "" while a run is live or when it shows
    // the run just finished, otherwise the bench.db campaign reloaded.
    in-out property <string> bench_showing: "";
    // The bench.db campaign whose report "Open report" opens; "" for none.
    in-out property <string> bench_report_campaign: "";
    // settings.ini `BenchDb` as typed: the database runs are written to and
    // the Saved runs list reads. Empty = bench\bench.db under the data folder.
    // The list follows the field as it is typed; settings.ini follows on Enter,
    // Browse… and Run, so the run lands where the list was reading.
    in-out property <string> bench_db;
    // Read-only readout: the resolved path and its campaign count, or that it
    // is not there yet, or why it cannot be read. Pushed from Rust.
    in-out property <string> bench_db_info: "";
    // The campaigns in bench.db, newest first (label = name, date and engine,
    // value = the campaign's name).
    in-out property <[string]> bench_run_labels;
    in-out property <[string]> bench_run_values;
    in-out property <int> bench_run_index: -1;

    // ── Integrations tab state ─────────────────────────────────────
    // All read-only projections, pushed by gui::refresh_integrations. There is
    // no model list here: OpenCode lists every ENABLED preset (the switch in the
    // Models tab), and the status line says whether opencode.json still does.
    in-out property <bool> integration_provider_active: false;
    in-out property <bool> integration_in_sync: true;
    in-out property <string> integration_status: "";
    in-out property <string> integration_claude_env: "";

    // ── Settings tab state ──────────────────────────────────────────
    // App-level preferences (the configurator's own, not llama-server's).
    // No Save/Revert and no dirty state: each toggle's callback fires AFTER
    // the two-way binding flipped the property, and Rust persists that value
    // immediately, or pushes the real state back on a failed write, which
    // reaches the checkbox precisely because the binding is two-way.
    // `start_at_login` + `start_minimized_to_tray` together mirror the
    // platform login entry, HKCU Run or XDG autostart (the entry IS the state; src/startup.rs:
    // presence, and whether the stored command carries `--minimized`);
    // `start_server_on_launch` lives in settings.ini (src/settings.rs). All
    // re-read on Refresh/F5. The tray toggle only means anything while
    // start_at_login is on (there is no login entry to shape otherwise),
    // so the page disables it; the kept value is what a fresh enable writes.
    in-out property <bool> startup_supported: true;
    in-out property <bool> start_at_login: false;
    in-out property <bool> start_minimized_to_tray: true;
    in-out property <bool> start_server_on_launch: false;
    // Log rotation (settings.ini `LogRotate` / `LogRotateKb`, src/settings.rs):
    // the toggle persists on click like the ones above; the threshold is a
    // text field (see "Numeric fields are text" in the README) committed on
    // Enter or focus loss through `commit_log_rotate_kb`, which parses it and
    // pushes the stored value back when the text is not a size.
    in-out property <bool> log_rotate: true;
    in-out property <string> log_rotate_kb: "1024";

    // ── Status / toast ───────────────────────────────────────────────
    in-out property <string> status_text: "";
    in-out property <bool> status_is_error: false;

    // ── Callbacks ────────────────────────────────────────────────────
    callback save_server();
    callback revert_server();
    // Directory picker, shared by every path field on the Server tab (models
    // root, snapshot dir). The argument is the path to open at; only an EMPTY
    // one falls back to the models root, and models_dir is the single field
    // that can be empty, so the fallback stays correct without a second
    // callback per field.
    callback browse_dir(string) -> string;

    // The (per-preset) GPU distribution table. Every
    // edit is a whole-selection rewrite in Rust (src/gpu_split.rs): the handler
    // rewrites the form's `device` + `tensor_split` strings, then REBUILDS the row
    // model. Devices are addressed by id, never by row index. See GpuSplitTable's
    // binding note (and why the row ORDER is fixed to the probe's).
    // `preset_gpu_move(id, delta)` is the drag handle: move a checked device `delta`
    // places within the split (negative = towards the head). Position 0 is
    // llama.cpp's main_gpu, so this is the only way to choose which GPU leads.
    // `preset_split_mode_picked(value)`: the mode combo's pick, as a MODE_VALUES
    // spelling ("default"/"none"/"tensor"/"row"). Rust writes it into the form
    // and rebuilds the rows: the mode decides what the columns mean, so a
    // pick is a full re-projection, not a scalar update.
    callback preset_split_mode_picked(string);
    callback preset_gpu_toggle(string);
    callback preset_gpu_move(string, int);
    callback preset_gpu_weight(string, int);
    // The same edit as `preset_gpu_weight` in blocks (see gpu_split::set_blocks).
    // It is COMMIT-based, not per-keystroke, because a block count is constrained
    // (giving one device more takes it from another), so unlike a weight it
    // cannot be applied without rewriting the other rows, and rewriting them on
    // every keystroke would recreate the very LineEdit being typed into.
    callback preset_gpu_blocks(string, int);
    callback preset_gpu_auto();
    callback preset_gpu_even();

    // Tensor-placement table. Same shape as the GPU table's: each one rewrites
    // the preset's `override_tensor`
    // string in Rust (src/tensor_override.rs) and rebuilds the row model, except
    // `preset_tensor_pattern`, the text field, which must NOT rebuild (that would
    // recreate the LineEdit being typed into and drop the caret), so it refreshes
    // only the derived strings. The int is the ROW INDEX; the string is the picked
    // kind id / device id / regex.
    callback preset_tensor_add();
    callback preset_tensor_remove(int);
    callback preset_tensor_kind(int, string);
    callback preset_tensor_device(int, string);
    callback preset_tensor_pattern(int, string);
    callback preset_tensor_layers(int, string);
    // The tensor picker: open on a rule; tick / fold one list line; tick or
    // clear everything; fold or unfold everything; write it back; close.
    callback preset_tensor_pick(int);
    callback tensor_picker_toggle(int);
    callback tensor_picker_expand(int);
    callback tensor_picker_all(bool);
    callback tensor_picker_expand_all(bool);
    callback tensor_picker_apply();
    callback tensor_picker_close();

    callback select_preset(int);
    // A row's on/off switch: (id, the state it was switched TO). Moves the
    // preset between presets.ini and presets.ini.disabled; the form is left
    // alone (see gui::refresh_preset_list).
    callback toggle_preset_enabled(string, bool);
    callback save_preset();
    callback revert_preset();
    // The Delete dialog (its state block above): open it on the selected
    // preset; tick or untick one file row; dismiss it (Cancel, Esc, the
    // backdrop), which drops the ticks; and confirm, `delete_preset(id)`.
    callback request_delete();
    callback delete_file_toggle(int);
    callback delete_cancel();
    callback delete_preset(string);
    callback new_preset();
    callback clone_preset();
    callback pick_new_empty();
    callback pick_new_clone();
    callback rename_preset(string, string);
    // Rename… button entry point. Routed through Rust (not opened Slint-side)
    // so a dirty form gets the same discard-confirm guard as the other
    // form-replacing navigations; committing a rename reloads from disk.
    callback request_rename();
    // Discard-confirm dialog verdict (see its state block above): confirm runs
    // the stashed pending action, cancel drops it.
    callback confirm_discard();
    callback cancel_discard();
    callback filter_presets(string);
    callback filter_dialog_models(string);
    // The Hugging Face dialog (src/gui/hf_dialog.rs). `hf_open` comes from the
    // New preset dialog's "From Hugging Face" button (so it inherits New…'s
    // discard guard); `hf_submit` (Search or List, by what the field holds),
    // and `hf_pick_result` run off the event loop; `hf_download` hands the job
    // to the background downloads and closes the dialog; `hf_dismiss` is Esc,
    // the backdrop and Close (no transfer ever runs IN the dialog, so it always
    // closes).
    // `hf_input_problem` and `hf_input_is_query` are pure: the field's error
    // ("" when it is a good spec, a query, or empty) and whether it searches,
    // so the button's label and the hint follow every keystroke.
    callback hf_open();
    callback hf_submit();
    // A search row was clicked: list that repository.
    callback hf_pick_result(int);
    // Leave the listing of a picked row for the search results again.
    callback hf_back_to_results();
    callback hf_select(int);
    // The mmproj tick or the drafter pill moved: recompute the summary line.
    callback hf_choices_changed();
    callback hf_download();
    callback hf_dismiss();
    // Open (or raise) the Downloads window (DownloadsWindow in
    // downloads_window.slint), a separate non-modal root wired in
    // gui/downloads.rs: the footer indicator, the modal's Downloads button and
    // the tray fire it.
    callback open_downloads();
    pure callback hf_input_problem(string) -> string;
    pure callback hf_input_is_query(string) -> bool;
    // Recompute the "Model info" box from the currently selected model file.
    callback model_changed();
    // Recompute `preset_kv_cache_warning`: fired by AppWindow when a cache type,
    // flash attention, the draft state or either device pin changes.
    callback kv_cache_inputs_changed();
    // A row was picked in the draft-model dropdown. The policy (set model_draft +
    // spec_type from the parallel arrays, auto-pin the draft device: the gemma4
    // MTP-crash workaround) lives in Rust (gui/models_tab.rs) where it is
    // unit-tested; the .slint side only reports the picked index.
    callback draft_picked(int);

    callback start_server();
    callback stop_server();
    // Open (or re-focus) the independent log-tail window (LogWindow in
    // log_window.slint), a separate non-modal root, so the main window stays
    // interactive while it is up. Wired in gui/log_window.rs.
    callback view_logs();
    // Open (or re-focus) the independent HW Monitor window (HwWindow in
    // hw_window.slint): live bars for every GPU, the CPU, memory and the
    // models directory's disk. Wired in gui/hw_window.rs, which exists on
    // Linux and Windows; `hw_monitor_available` is set where it was wired, so
    // the button does not show where it would do nothing.
    callback open_hw_monitor();
    in property <bool> hw_monitor_available;
    // Re-read server.ini / presets.ini and re-scan the models directory.
    // Picks up files added on disk or config files edited by hand outside
    // the GUI, without restarting the app.
    callback reload_all();

    // Benchmark tab. `bench_mode_picked` / `bench_toggle_preset` rewrite the
    // selection in Rust and rebuild the row model (same contract as the GPU
    // table: a row's checkbox binding is one-way, so anything that changes
    // another row must rebuild). `bench_changed` is the catch-all a workload
    // field's `edited` fires: it re-renders the preview from the same code that
    // builds the real command. `bench_run` validates and starts; `bench_cancel`
    // stops at the next repetition or test boundary.
    callback bench_mode_picked(string);
    callback bench_toggle_preset(string);
    callback bench_changed();
    callback bench_run();
    callback bench_cancel();
    callback bench_run_picked(string);
    // Open the current campaign's markdown report in the default editor.
    callback bench_open_report();
    // The prompt file: pick one (returns the picked path, or the argument back
    // when the dialog is cancelled, exactly like `browse_dir`), and open the
    // current one in the system's default text editor.
    //
    // Editing happens THERE and not in a window of ours on purpose: a Slint
    // TextEdit is already sluggish at a few hundred KB (see log_window.slint,
    // which shows its tail as a list of rows for that reason), and the prompts worth
    // keeping in a file are the long ones. The file is re-read when it changes
    // and again when Run starts, so an external editor is a live editor.
    callback bench_pick_prompt(string) -> string;
    callback bench_edit_prompt();
    // The benchmark database: `bench_db_changed` re-lists the campaigns at the
    // typed path (no write), `bench_db_accepted` also saves it to settings.ini,
    // `bench_pick_db` is the picker (same contract as `bench_pick_prompt`).
    callback bench_db_changed();
    callback bench_db_accepted();
    callback bench_pick_db(string) -> string;

    callback save_integrations();
    callback open_opencode_folder();

    // Settings tab: fired AFTER the two-way binding flipped the property (see
    // the state block above); Rust reads the new value and persists it.
    callback toggle_start_at_login();
    callback toggle_start_minimized();
    callback toggle_start_server_on_launch();
    callback toggle_log_rotate();
    // Fired on Enter / focus loss in the threshold field; Rust parses
    // `log_rotate_kb` and persists it, or restores the stored value.
    callback commit_log_rotate_kb();
}
