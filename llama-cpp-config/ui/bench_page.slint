// BenchPage: the benchmark tab. All state lives in AppState (state.slint); this
// component just lays out the widgets against it.
//
// Layout (grep `heading:`): Engine -> Presets -> Workload -> Campaign -> Preview
// (+ the Run row) -> Results -> Saved runs.
//
// The ENGINE selector comes first because it decides everything below it: which
// half of the Workload card is live, what the preview shows, and which
// llama-server state the run needs. Live drives the RUNNING server with a real
// prompt (production numbers, drafter included); synthetic runs llama-bench over
// token counts, which takes no prompt and never samples. Same ordering rule as
// the GPU table's split-mode combo: the thing that decides what the fields below
// MEAN sits above them.
//
// Editable widgets bind two-way (`<=>`): a one-way binding breaks the moment the
// user types (Slint's "overwritten bindings" rule), which would leave the field
// stale after a mode switch or a reload. The per-row checkbox below is the
// sanctioned exception, with the same invariant as the Integrations list: the
// only in-place row write originates from the clicked widget itself, and every
// other change rebuilds the whole model.

import { LineEdit, TextEdit, CheckBox, Button, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { SectionCard, LabeledField, SegmentedControl, MappedComboBox, EnumComboBox, DefaultLineEdit, WrapText, LabelColumn, Tokens } from "components.slint";
import { AppState } from "state.slint";
import { Strings } from "strings.slint";

export component BenchPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: Strings.t("benchmark");
            font-size: 22px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: Strings.t("benchmark-intro");
            color: Palette.foreground.transparentize(Tokens.muted);
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionCard {
            heading: Strings.t("engine");
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("mode");
                hint: Strings.t("mode-hint");
                SegmentedControl {
                    options: ["live", "synthetic"];
                    labels: [Strings.t("live"), Strings.t("synthetic")];
                    current: AppState.bench_mode;
                    activated(v) => { AppState.bench_mode_picked(v); }
                }
            }
            WrapText {
                text: AppState.bench_caveats;
                font_size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }
        }

        SectionCard {
            heading: Strings.t("presets");
            content_padding: 8px;

            if AppState.bench_presets.length == 0 : Text {
                text: Strings.t("no-presets");
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }

            for item[i] in AppState.bench_presets : Rectangle {
                height: 40px;
                // Tint with the WINDOW background: these rows sit on a
                // SectionCard, whose surface IS alternate-background.
                background: Math.mod(i, 2) == 0 ? transparent : Palette.background.transparentize(Tokens.zebra);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    // One-way `checked`, same contract as the Integrations row:
                    // the click self-assigns and breaks THIS delegate's binding,
                    // which is invisible only because every other change to the
                    // selection rebuilds the model (gui/bench_tab.rs).
                    CheckBox {
                        text: "";
                        accessible-label: "bench-" + item.id;
                        enabled: !AppState.bench_running;
                        checked: item.selected;
                        toggled => { AppState.bench_toggle_preset(item.id); }
                    }
                    Text {
                        // The run order, and position 1 is not decoration: it is
                        // the baseline every ratio is measured against.
                        width: 28px;
                        text: item.order > 0 ? item.order + "." : "";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(Tokens.muted);
                        vertical-alignment: center;
                    }
                    Text {
                        text: item.id;
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                        min-width: 260px;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: item.model;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(Tokens.muted);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        SectionCard {
            heading: Strings.t("workload");

            // ── live half ────────────────────────────────────────────
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("prompts");
                hint: Strings.t("prompts-hint");
                VerticalLayout {
                    spacing: 4px;
                    for row[i] in AppState.bench_prompts : HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            accessible-label: "bench-prompt-" + row.name;
                            text: row.name;
                            checked: row.on;
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            toggled => { AppState.bench_prompt_toggle(i); }
                        }
                        // The file as it stands on disk: size and digest, or the
                        // reason it cannot be read, the answer to "is that the
                        // prompt I think it is" right before Run.
                        Text {
                            text: row.info;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: Strings.t("edit");
                            clicked => { AppState.bench_prompt_edit(i); }
                        }
                        if !row.shipped : Button {
                            text: Strings.t("remove");
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            clicked => { AppState.bench_prompt_remove(i); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: Strings.t("add-file");
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            clicked => { AppState.bench_prompt_add(); }
                        }
                    }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("temperature");
                hint: Strings.t("temperature-hint");
                DefaultLineEdit {
                    edit_label: "bench-temp";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    default <=> AppState.bench_temp_default;
                    value <=> AppState.bench_temp;
                    input_type: InputType.decimal;
                    placeholder: "0";
                    edited => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("max-output-tokens");
                hint: Strings.t("max-output-tokens-hint");
                LineEdit {
                    accessible-label: "bench-max-tokens";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    text <=> AppState.bench_max_tokens;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("image");
                hint: Strings.t("image-hint");
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 180px;
                        height: 120px;
                        border-width: 1px;
                        border-color: Palette.border;
                        Image {
                            accessible-label: "bench-image-preview";
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            source: AppState.bench_image_preview;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: AppState.bench_image_info;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            wrap: word-wrap;
                            max-width: 360px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: Strings.t("choose");
                                enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                                clicked => { AppState.bench_image_pick(); }
                            }
                            if AppState.bench_image != "" : Button {
                                text: Strings.t("use-prompt-image");
                                enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                                clicked => { AppState.bench_image_clear(); }
                            }
                        }
                    }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("image-size");
                hint: Strings.t("image-size-hint");
                LineEdit {
                    accessible-label: "bench-image-size";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    text <=> AppState.bench_image_size;
                    placeholder-text: "1344x896";
                    edited => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("concurrency");
                hint: Strings.t("concurrency-hint");
                SegmentedControl {
                    options: ["single", "prefill", "decode", "prefill+decode", "all"];
                    labels: [Strings.t("single"), Strings.t("prefill"), Strings.t("decode"), Strings.t("prefill-decode"), Strings.t("all")];
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    current: AppState.bench_concurrency;
                    activated(v) => {
                        AppState.bench_concurrency = v;
                        AppState.bench_changed();
                    }
                }
            }

            // ── synthetic half ───────────────────────────────────────
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("prompt-lengths");
                hint: Strings.t("prompt-lengths-hint");
                LineEdit {
                    accessible-label: "bench-prompt-lens";
                    text <=> AppState.bench_prompt_lens;
                    edited => { AppState.bench_changed(); }
                }
            }
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("generate");
                hint: Strings.t("generate-hint");
                LineEdit {
                    accessible-label: "bench-n-gen";
                    text <=> AppState.bench_n_gen;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("depths");
                hint: Strings.t("depths-hint");
                LineEdit {
                    accessible-label: "bench-depths";
                    text <=> AppState.bench_depths;
                    edited => { AppState.bench_changed(); }
                }
            }

            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("repetitions");
                hint: Strings.t("repetitions-hint");
                LineEdit {
                    accessible-label: "bench-reps";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    text <=> AppState.bench_reps;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
        }

        SectionCard {
            heading: Strings.t("campaign");
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("spec");
                hint: Strings.t("spec-hint");
                EnumComboBox {
                    accessible-label: "bench-spec";
                    enabled: !AppState.bench_running;
                    options: AppState.bench_spec_options;
                    labels: AppState.bench_spec_labels;
                    value <=> AppState.bench_spec;
                    changed value => { AppState.bench_spec_changed(); }
                }
                Button {
                    text: Strings.t("load");
                    enabled: !AppState.bench_running;
                    clicked => { AppState.bench_spec_load(); }
                }
                Button {
                    text: Strings.t("save-as");
                    enabled: !AppState.bench_running;
                    clicked => { AppState.bench_spec_save(); }
                }
            }
            if AppState.bench_spec != "custom" : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "";
                hint: Strings.t("spec-override-hint");
                CheckBox {
                    text: Strings.t("spec-override");
                    enabled: !AppState.bench_running;
                    checked <=> AppState.bench_spec_override;
                    toggled => { AppState.bench_override_toggled(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("name");
                hint: Strings.t("campaign-name-hint");
                LineEdit {
                    accessible-label: "bench-campaign";
                    enabled: !AppState.bench_running;
                    text <=> AppState.bench_campaign;
                    placeholder-text: "<stamp>";
                    edited => { AppState.bench_changed(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("question");
                hint: Strings.t("question-hint");
                LineEdit {
                    accessible-label: "bench-question";
                    enabled: !AppState.bench_running;
                    text <=> AppState.bench_question;
                    edited => { AppState.bench_changed(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("ab-key");
                hint: Strings.t("ab-key-hint");
                EnumComboBox {
                    accessible-label: "bench-ab-key";
                    enabled: !AppState.bench_running;
                    options: AppState.bench_ab_keys;
                    labels: AppState.bench_ab_key_labels;
                    value <=> AppState.bench_ab_key;
                    changed value => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_ab_key != "none" : LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("values");
                hint: Strings.t("values-hint");
                LineEdit {
                    accessible-label: "bench-ab-values";
                    enabled: !AppState.bench_running;
                    placeholder-text: "e.g. 512,1024";
                    text <=> AppState.bench_ab_values;
                    edited => { AppState.bench_changed(); }
                }
            }
        }

        SectionCard {
            heading: Strings.t("preview");
            content_padding: 12px;
            Text {
                text: Strings.t("preview-intro");
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }
            // Auto-height off a hidden mirror Text, the same trick (and the same
            // +48px for the TextEdit's border and padding) as the Server tab's
            // Command Line card: the box shows the whole thing with no inner
            // scrollbar, and stays a read-only TextEdit so it can be selected
            // and copied.
            Rectangle {
                height: mirror.preferred-height + 48px;
                mirror := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: AppState.bench_preview;
                    wrap: word-wrap;
                    visible: false;
                }
                TextEdit {
                    width: 100%;
                    height: 100%;
                    text: AppState.bench_preview;
                    read-only: true;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: AppState.bench_running ? Strings.t("running") : Strings.t("run-benchmark");
                primary: true;
                enabled: !AppState.bench_running && AppState.bench_selected_count > 0;
                clicked => { AppState.bench_run(); }
            }
            Button {
                text: Strings.t("cancel");
                enabled: AppState.bench_running;
                clicked => { AppState.bench_cancel(); }
            }
            Text {
                text: AppState.bench_progress;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        SectionCard {
            heading: Strings.t("results");
            content_padding: 8px;

            if AppState.bench_rows.length == 0 : Text {
                text: Strings.t("no-results");
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }

            if AppState.bench_rows.length > 0 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    width: 130px;
                    text: Strings.t("test");
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    text: Strings.t("preset");
                    horizontal-stretch: 1;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 80px;
                    text: "t/s";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 60px;
                    text: "sd";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 40px;
                    text: "n";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 70px;
                    text: AppState.bench_baseline != "" ? "vs 1." : Strings.t("ratio");
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
            }

            for row[i] in AppState.bench_rows : Rectangle {
                height: row.note == "" ? 32px : 46px;
                background: Math.mod(i, 2) == 0 ? transparent : Palette.background.transparentize(Tokens.zebra);

                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            width: 130px;
                            text: row.test;
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.preset;
                            horizontal-stretch: 1;
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            width: 80px;
                            text: row.mean;
                            horizontal-alignment: right;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 60px;
                            text: row.sd;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.faint);
                            vertical-alignment: center;
                        }
                        Text {
                            width: 40px;
                            text: row.samples;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.faint);
                            vertical-alignment: center;
                        }
                        Text {
                            width: 70px;
                            text: row.ratio;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            vertical-alignment: center;
                        }
                    }
                    if row.note != "" : HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: row.note;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            overflow: elide;
                        }
                    }
                }
            }
        }

        SectionCard {
            heading: Strings.t("saved-runs");
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("database");
                hint: Strings.t("database-hint");
                LineEdit {
                    accessible-label: "bench-db";
                    text <=> AppState.bench_db;
                    placeholder-text: "bench\\bench.db";
                    enabled: !AppState.bench_running;
                    edited => { AppState.bench_db_changed(); }
                    accepted => { AppState.bench_db_accepted(); }
                }
                Button {
                    text: Strings.t("browse");
                    enabled: !AppState.bench_running;
                    clicked => {
                        AppState.bench_db = AppState.bench_pick_db(AppState.bench_db);
                    }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "";
                Text {
                    text: AppState.bench_db_info;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: Strings.t("run");
                hint: Strings.t("run-hint");
                MappedComboBox {
                    enabled: !AppState.bench_running && AppState.bench_run_labels.length > 0;
                    labels: AppState.bench_run_labels;
                    values: AppState.bench_run_values;
                    index <=> AppState.bench_run_index;
                    picked(v) => { AppState.bench_run_picked(v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: Strings.t("open-report");
                    enabled: AppState.bench_report_campaign != "";
                    clicked => { AppState.bench_open_report(); }
                }
            }
        }
    }
}
