// BenchPage: the benchmark tab. All state lives in AppState (state.slint); this
// component just lays out the widgets against it.
//
// Layout (grep `heading:`): Engine -> Presets -> Workload -> Campaign -> Preview
// (+ the Run row) -> Results -> Saved runs.
//
// The ENGINE selector comes first because it decides everything below it: which
// half of the Workload card is live, what the preview shows, and which
// llama-server state the run needs. Live drives the RUNNING server with a real
// prompt (production numbers, drafter included); synthetic runs llama-bench over
// token counts, which takes no prompt and never samples. Same ordering rule as
// the GPU table's split-mode combo: the thing that decides what the fields below
// MEAN sits above them.
//
// Editable widgets bind two-way (`<=>`): a one-way binding breaks the moment the
// user types (Slint's "overwritten bindings" rule), which would leave the field
// stale after a mode switch or a reload. The per-row checkbox below is the
// sanctioned exception, with the same invariant as the Integrations list: the
// only in-place row write originates from the clicked widget itself, and every
// other change rebuilds the whole model.

import { LineEdit, TextEdit, CheckBox, Button, ComboBox, ScrollView, Palette } from "std-widgets.slint";
import { SectionCard, LabeledField, SegmentedControl, MappedComboBox, EnumComboBox, DefaultLineEdit, WrapText, LabelColumn, Tokens } from "components.slint";
import { AppState } from "state.slint";

export component BenchPage inherits ScrollView {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        Text {
            text: "Benchmark";
            font-size: 22px;
            font-weight: 600;
            color: Palette.foreground;
        }
        Text {
            text: "Measure one preset, or compare several. The unit is the preset, not the model file: two presets over the same .gguf are a legitimate comparison, and usually the interesting one.";
            color: Palette.foreground.transparentize(Tokens.muted);
            font-size: 12px;
            wrap: word-wrap;
        }

        SectionCard {
            heading: "Engine";
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Mode";
                hint: "live: real requests to the RUNNING llama-server, with your prompt and a temperature override. Measures what the preset actually does, speculative drafter and chat template included.\nsynthetic: llama-bench over token counts. It takes no prompt and never samples, so it is perfectly reproducible, but it cannot load the preset's drafter and ignores the mmproj, the template and the reasoning flags.\nlive needs llama-server running; synthetic needs it stopped, and stops it for you.";
                SegmentedControl {
                    options: ["live", "synthetic"];
                    current: AppState.bench_mode;
                    activated(v) => { AppState.bench_mode_picked(v); }
                }
            }
            WrapText {
                text: AppState.bench_caveats;
                font_size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
            }
        }

        SectionCard {
            heading: "Presets";
            content_padding: 8px;

            if AppState.bench_presets.length == 0 : Text {
                text: "No presets found. Create one under the Models tab first.";
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }

            for item[i] in AppState.bench_presets : Rectangle {
                height: 40px;
                // Tint with the WINDOW background: these rows sit on a
                // SectionCard, whose surface IS alternate-background.
                background: Math.mod(i, 2) == 0 ? transparent : Palette.background.transparentize(Tokens.zebra);

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    // One-way `checked`, same contract as the Integrations row:
                    // the click self-assigns and breaks THIS delegate's binding,
                    // which is invisible only because every other change to the
                    // selection rebuilds the model (gui/bench_tab.rs).
                    CheckBox {
                        text: "";
                        accessible-label: "bench-" + item.id;
                        enabled: !AppState.bench_running;
                        checked: item.selected;
                        toggled => { AppState.bench_toggle_preset(item.id); }
                    }
                    Text {
                        // The run order, and position 1 is not decoration: it is
                        // the baseline every ratio is measured against.
                        width: 28px;
                        text: item.order > 0 ? item.order + "." : "";
                        font-size: 12px;
                        color: Palette.foreground.transparentize(Tokens.muted);
                        vertical-alignment: center;
                    }
                    Text {
                        text: item.id;
                        font-size: 13px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: center;
                        min-width: 260px;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: item.model;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(Tokens.muted);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        SectionCard {
            heading: "Workload";

            // ── live half ────────────────────────────────────────────
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Prompts";
                hint: "The files whose text is sent verbatim as a single user message, each ticked one in turn (one step per prompt, into one campaign). Each is re-sent whole on every repetition with the prefix cache disabled, so each one is a cold prefill, which is what the prefill row measures.\nTwo prompts ship, side by side in config\\: bench-prompt-43k.txt (the default, 43.7k tokens) and bench-prompt-110k.txt (110k tokens), the two the standard spec pins; + adds a file of your own (a custom run, or with a spec a derived one). The ranking of a knob can differ with the context you actually work at, which is why neither is short.\nRead fresh when Run starts, so editing one while this window is open is enough: Edit opens it in your default text editor. The first ticked one is also what `bench sweep` reads with no --prompt-file.";
                VerticalLayout {
                    spacing: 4px;
                    for row[i] in AppState.bench_prompts : HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            accessible-label: "bench-prompt-" + row.name;
                            text: row.name;
                            checked: row.on;
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            toggled => { AppState.bench_prompt_toggle(i); }
                        }
                        // The file as it stands on disk: size and digest, or the
                        // reason it cannot be read, the answer to "is that the
                        // prompt I think it is" right before Run.
                        Text {
                            text: row.info;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Edit";
                            clicked => { AppState.bench_prompt_edit(i); }
                        }
                        if !row.shipped : Button {
                            text: "Remove";
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            clicked => { AppState.bench_prompt_remove(i); }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "+ Browse…";
                            enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                            clicked => { AppState.bench_prompt_add(); }
                        }
                    }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Temperature";
                hint: "Overrides the preset's own --temp for this run. 0 is greedy sampling, which is what makes two runs of the same prompt comparable; tick 'default' to leave the preset's value alone and accept the variance.";
                DefaultLineEdit {
                    edit_label: "bench-temp";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    default <=> AppState.bench_temp_default;
                    value <=> AppState.bench_temp;
                    input_type: InputType.decimal;
                    placeholder: "0";
                    edited => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Max output tokens";
                hint: "Cap on the generated answer (--max_tokens on the request). Long enough that the decode rate settles, short enough that a slow model does not turn one repetition into minutes.\n0 = no cap: the request carries no max_tokens and the model stops on its own (or at the preset's n-predict), so how long it talks is part of the result.";
                LineEdit {
                    accessible-label: "bench-max-tokens";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    text <=> AppState.bench_max_tokens;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Concurrency";
                hint: "single: one request per repetition.\nThe others send one request per slot of the preset AT ONCE, N = the preset's parallel (absent = llama-server's auto 4; it must be at least 2), each pinned to its slot:\nprefill: all N prefill the whole prompt, then decode together.\ndecode: every slot is primed with the prompt first, so all N only decode.\nprefill+decode: N-1 primed slots decode while the last one prefills.\nThe table adds prefill total and decode total, the throughput of the N requests together.\nall: each of the four in turn, into one campaign (single alone when a selected preset has parallel below 2), as `bench sweep --concurrency all`.";
                SegmentedControl {
                    options: ["single", "prefill", "decode", "prefill+decode", "all"];
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    current: AppState.bench_concurrency;
                    activated(v) => {
                        AppState.bench_concurrency = v;
                        AppState.bench_changed();
                    }
                }
            }

            // ── synthetic half ───────────────────────────────────────
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Prompt lengths";
                hint: "llama-bench's -p: how many TOKENS to prefill, comma separated. Not a text: this engine never tokenizes a prompt of yours and never samples. One pp row per length.";
                LineEdit {
                    accessible-label: "bench-prompt-lens";
                    text <=> AppState.bench_prompt_lens;
                    edited => { AppState.bench_changed(); }
                }
            }
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Generate";
                hint: "llama-bench's -n: how many tokens to generate per decode test.";
                LineEdit {
                    accessible-label: "bench-n-gen";
                    text <=> AppState.bench_n_gen;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
            if !AppState.bench_is_live : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Depths";
                hint: "llama-bench's -d: how many tokens of KV cache to prefill before each decode test, comma separated. Decode slows down with context, so a single depth of 0 measures only the best case.";
                LineEdit {
                    accessible-label: "bench-depths";
                    text <=> AppState.bench_depths;
                    edited => { AppState.bench_changed(); }
                }
            }

            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Repetitions";
                hint: "Samples per measurement. The results table reports the mean and the sample standard deviation across them, which is what says whether a difference between two presets is real.";
                LineEdit {
                    accessible-label: "bench-reps";
                    enabled: AppState.bench_spec == "custom" || AppState.bench_spec_override;
                    text <=> AppState.bench_reps;
                    input-type: InputType.number;
                    edited => { AppState.bench_changed(); }
                }
            }
        }

        SectionCard {
            heading: "Campaign";
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Spec";
                hint: "The method: custom runs the Workload fields above and records spec = custom; standard v<N> runs that published version of the framework's method (benchmarks/specs/standard.ini, its versions frozen in standard.versions), the version this binary carries. Load… opens a spec file of yours and Save as… writes what the card describes as one (never the official one: the name standard is refused); a spec of yours runs like the official one but records every run as spec = custom, derived from it. A spec fixes the prompts, temperature, output cap, concurrency and repetitions, so those fields are greyed out; it records spec, spec-version, spec-sha256 and spec-pass with every run, which is what makes runs of two machines comparable. Live only. A pass that overrides a preset key (the engine pass sets spec-type = none) writes it to the selected presets for its steps, restarting llama-server around them, and puts it back.";
                EnumComboBox {
                    accessible-label: "bench-spec";
                    enabled: !AppState.bench_running;
                    options: AppState.bench_spec_options;
                    value <=> AppState.bench_spec;
                    changed value => { AppState.bench_spec_changed(); }
                }
                Button {
                    text: "Load…";
                    enabled: !AppState.bench_running;
                    clicked => { AppState.bench_spec_load(); }
                }
                Button {
                    text: "Save as…";
                    enabled: !AppState.bench_running;
                    clicked => { AppState.bench_spec_save(); }
                }
            }
            if AppState.bench_spec != "custom" : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "";
                hint: "Re-enables the Workload fields. Each one you change after ticking this replaces the spec's value in every step (the prompt replaces its prompt list, a concurrency its scenarios); the rest stays the spec's. The runs are then not of the spec: they record spec = custom, with spec-derived-from naming the version and spec-derived-fields what changed.";
                CheckBox {
                    text: "Override (custom, derived from the spec)";
                    enabled: !AppState.bench_running;
                    checked <=> AppState.bench_spec_override;
                    toggled => { AppState.bench_override_toggled(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Name";
                hint: "The bench.db campaign the runs go into, as `--campaign`: an existing name adds to it. Empty: a campaign of its own, named after the run's stamp (spec-<name>-v<version>-<stamp> for a spec).";
                LineEdit {
                    accessible-label: "bench-campaign";
                    enabled: !AppState.bench_running;
                    text <=> AppState.bench_campaign;
                    placeholder-text: "<stamp>";
                    edited => { AppState.bench_changed(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Question";
                hint: "What the campaign is meant to answer, as `--question`: stored with it, and what `bench answer` later answers.";
                LineEdit {
                    accessible-label: "bench-question";
                    enabled: !AppState.bench_running;
                    text <=> AppState.bench_question;
                    edited => { AppState.bench_changed(); }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "A/B key";
                hint: "A preset key to compare values of, as bench sweep --key: every step of the run (each prompt, scenario and spec pass) runs once per value, with the value written to the selected presets and llama-server restarted around it; the key is put back afterwards. The list is the preset keys that change how the model is launched (placement, KV cache, batch sizes, speculator...). none = no A/B.\nUnder a spec, a key its passes do not touch keeps the runs spec runs; a key a pass overrides (spec-type under standard) records them as custom, derived from the spec.";
                EnumComboBox {
                    accessible-label: "bench-ab-key";
                    enabled: !AppState.bench_running;
                    options: AppState.bench_ab_keys;
                    value <=> AppState.bench_ab_key;
                    changed value => { AppState.bench_changed(); }
                }
            }
            if AppState.bench_ab_key != "none" : LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Values";
                hint: "The values to compare, as bench sweep --values: comma-separated, a range 2..8, `unset` to remove the key for one leg; separate with ; when a value holds commas (tensor-split, device), and end a single such value with ;. Each value is checked against the presets before Run starts.";
                LineEdit {
                    accessible-label: "bench-ab-values";
                    enabled: !AppState.bench_running;
                    placeholder-text: "e.g. 512,1024";
                    text <=> AppState.bench_ab_values;
                    edited => { AppState.bench_changed(); }
                }
            }
        }

        SectionCard {
            heading: "Preview";
            content_padding: 12px;
            Text {
                text: "Exactly what Run will do, built by the same code that runs it.";
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }
            // Auto-height off a hidden mirror Text, the same trick (and the same
            // +48px for the TextEdit's border and padding) as the Server tab's
            // Command Line card: the box shows the whole thing with no inner
            // scrollbar, and stays a read-only TextEdit so it can be selected
            // and copied.
            Rectangle {
                height: mirror.preferred-height + 48px;
                mirror := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: AppState.bench_preview;
                    wrap: word-wrap;
                    visible: false;
                }
                TextEdit {
                    width: 100%;
                    height: 100%;
                    text: AppState.bench_preview;
                    read-only: true;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: AppState.bench_running ? "Running…" : "Run benchmark";
                primary: true;
                enabled: !AppState.bench_running && AppState.bench_selected_count > 0;
                clicked => { AppState.bench_run(); }
            }
            Button {
                text: "Cancel";
                enabled: AppState.bench_running;
                clicked => { AppState.bench_cancel(); }
            }
            Text {
                text: AppState.bench_progress;
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        SectionCard {
            heading: "Results";
            content_padding: 8px;

            if AppState.bench_rows.length == 0 : Text {
                text: "Nothing measured yet. Results appear here as each test completes, and every one is written to disk as it lands, so a run that dies keeps what it had.";
                font-size: 12px;
                color: Palette.foreground.transparentize(Tokens.muted);
                wrap: word-wrap;
            }

            if AppState.bench_rows.length > 0 : HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    width: 130px;
                    text: "Test";
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    text: "Preset";
                    horizontal-stretch: 1;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 80px;
                    text: "t/s";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 60px;
                    text: "sd";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 40px;
                    text: "n";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
                Text {
                    width: 70px;
                    text: AppState.bench_baseline != "" ? "vs 1." : "ratio";
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                }
            }

            for row[i] in AppState.bench_rows : Rectangle {
                height: row.note == "" ? 32px : 46px;
                background: Math.mod(i, 2) == 0 ? transparent : Palette.background.transparentize(Tokens.zebra);

                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            width: 130px;
                            text: row.test;
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: row.preset;
                            horizontal-stretch: 1;
                            font-size: 12px;
                            color: Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            width: 80px;
                            text: row.mean;
                            horizontal-alignment: right;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 60px;
                            text: row.sd;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.faint);
                            vertical-alignment: center;
                        }
                        Text {
                            width: 40px;
                            text: row.samples;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.faint);
                            vertical-alignment: center;
                        }
                        Text {
                            width: 70px;
                            text: row.ratio;
                            horizontal-alignment: right;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            vertical-alignment: center;
                        }
                    }
                    if row.note != "" : HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: row.note;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(Tokens.muted);
                            overflow: elide;
                        }
                    }
                }
            }
        }

        SectionCard {
            heading: "Saved runs";
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Database";
                hint: "The SQLite file every finished run is written to, and the one listed below. Empty = bench\\bench.db under the data folder. Point it at a clone's benchmarks\\bench.db to record straight into the repo's database, with no bench publish; absolute paths are cut to file names and secret-like values dropped either way.\nA file that is not there yet is created by the first finished run. Enter, Browse… or Run saves the path to settings.ini (BenchDb), where bench sweep and bench query read it too.";
                LineEdit {
                    accessible-label: "bench-db";
                    text <=> AppState.bench_db;
                    placeholder-text: "bench\\bench.db";
                    enabled: !AppState.bench_running;
                    edited => { AppState.bench_db_changed(); }
                    accepted => { AppState.bench_db_accepted(); }
                }
                Button {
                    text: "Browse…";
                    enabled: !AppState.bench_running;
                    clicked => {
                        AppState.bench_db = AppState.bench_pick_db(AppState.bench_db);
                    }
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "";
                Text {
                    text: AppState.bench_db_info;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(Tokens.muted);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            LabeledField {
                label_width <=> LabelColumn.bench;
                label: "Run";
                hint: "Every run is a campaign in the database above: each preset is written when it has been measured to the end, with its parameters, every repetition and the engine's output; a preset that fails or is cancelled is not recorded. Picking one here reloads its table; bench sweep campaigns are listed too, one column per value.";
                MappedComboBox {
                    enabled: !AppState.bench_running && AppState.bench_run_labels.length > 0;
                    labels: AppState.bench_run_labels;
                    values: AppState.bench_run_values;
                    index <=> AppState.bench_run_index;
                    picked(v) => { AppState.bench_run_picked(v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Open report";
                    enabled: AppState.bench_report_campaign != "";
                    clicked => { AppState.bench_open_report(); }
                }
            }
        }
    }
}
