build/
dist/

# generated by xtask configure alongside build\windows\config-build.psd1: cargo's job
# count + test threads, both derived from THIS machine's core count
.cargo/

# generated by resources/generate-llama-ico.mjs (build.rs / xtask package run
# it when the file is missing), plus the script's transient npm deps
resources/llama.ico
resources/node_modules/
resources/package.json
resources/package-lock.json

# the project skills live in .agents/skills (shared across harnesses);
# .claude/skills is a symlink to it; .claude/agents holds the Claude Code
# subagents (thin: they load a skill); everything else under .claude stays local
.claude/*
!.claude/skills
!.claude/agents
# settings.json is shared (paths in it are relative, so it holds on any
# checkout and on both OSes); everything else under .vscode stays local
.vscode/*
!.vscode/settings.json

# Python bytecode (benchmarks/*.py imported by each other or by a test)
__pycache__/
*.pyc

# a bare `cargo build` at the workspace root before xtask configure has run
/target/
