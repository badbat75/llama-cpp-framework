build/
dist/

# generated by 01-configure.ps1 alongside build\windows\config-build.psd1: cargo's job
# count + test threads, both derived from THIS machine's core count
.cargo/

# generated by resources/generate-llama-ico.mjs (build.rs / 03-package.ps1 run
# it when the file is missing), plus the script's transient npm deps
resources/llama.ico
resources/node_modules/
resources/package.json
resources/package-lock.json

# the project skills live in .agents/skills (shared across harnesses);
# .claude/skills is a symlink to it, everything else under .claude stays local
.claude/*
!.claude/skills
# settings.json is shared (paths in it are relative, so it holds on any
# checkout and on both OSes); everything else under .vscode stays local
.vscode/*
!.vscode/settings.json

# Python bytecode (benchmarks/*.py imported by each other or by a test)
__pycache__/
*.pyc
